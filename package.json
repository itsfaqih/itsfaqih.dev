{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "imports": {
    "#og/jsx-runtime": "./scripts/og/jsx-runtime.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vp test run --project unit",
    "typecheck": "tsrs --noEmit",
    "lint": "vp lint",
    "format": "vp fmt .",
    "test:visual": "astro build && vp test run --project visual",
    "test:visual:update": "astro build && UPDATE_VISUAL=1 vp test run --project visual",
    "test:behavior": "astro build && vp test run --project behavior",
    "test:behavior:update": "astro build && UPDATE_BEHAVIOR=1 vp test run --project behavior",
    "test:sounds": "astro build && node scripts/verify-sounds.ts",
    "verify": "vp run lint && vp fmt --check . && vp run typecheck && vp run test && astro build && vp test run --project visual && vp test run --project behavior && node scripts/verify-sounds.ts",
    "prepare": "lefthook install && astro sync"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@pierre/diffs": "^1.6.2",
    "@types/mdx": "^2.0.14",
    "@vanilla-extract/css": "^1.21.3",
    "astro": "7.4.4",
    "fuse.js": "^7.5.0",
    "lenis": "^1.3.27",
    "rehype-slug": "^6.0.0",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/fontkit": "^2.0.9",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "browserslist": "4.28.1",
    "fontkit": "^2.0.4",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "lightningcss": "1.33.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "satori": "^0.63.2",
    "svgo": "^4.1.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "unplugin": "^2.3.11",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.153.0"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 141",
    "firefox >= 140",
    "safari >= 26.1",
    "ios_saf >= 18.5",
    "opera >= 124",
    "samsung >= 28"
  ],
  "packageManager": "pnpm@12.16.1"
}
