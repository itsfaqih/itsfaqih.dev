---
import type { MarkdownHeading } from "astro";
import { cx } from "../cx";
import { marker } from "../when";
import { styles } from "./table-of-contents.css";
import { tocLink } from "./table-of-contents.view";

type Props = { headings: MarkdownHeading[] };

const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  headings.length > 0 && (
    <table-of-contents class={styles.host}>
      <nav>
        <p class={styles.title}>On this page</p><ul class={cx(styles.list, marker)}>
          {headings.map(({ depth, slug, text }) => (
            <li class={cx(styles.item, depth === 3 && styles.depth3)}><a href={`#${slug}`} class={tocLink(false)}><span class={styles.label}><span class={styles.layer}>{text}</span><span aria-hidden="true" class={cx(styles.layer, styles.ghost)}>{text}</span></span></a></li>
          ))}
        </ul>
      </nav>
    </table-of-contents>
  )
}

<script>
  import "./table-of-contents.client";
</script>
