---
import type { MarkdownHeading } from "astro";
import { toc } from "./table-of-contents.styles";

type Props = { headings: MarkdownHeading[] };

const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  headings.length > 0 && (
    <table-of-contents class={toc.host}>
      <nav>
        <p class={toc.title}>On this page</p><ul class={toc.list}>
          {headings.map(({ depth, slug, text }) => (
            <li class={toc.item} style={`padding-left:${(depth - 2) * 12}px`}><a href={`#${slug}`} class={toc.link(false)}><span class={toc.label}><span class={toc.layer}>{text}</span><span aria-hidden="true" class={toc.ghost}>{text}</span></span></a></li>
          ))}
        </ul>
      </nav>
    </table-of-contents>
  )
}

<script>
  import "./table-of-contents.client";
</script>
