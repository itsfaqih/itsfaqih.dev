---
import type { MarkdownHeading } from "astro";
import Icon from "../components/icon.astro";
import { drawer } from "./post.styles";
import TableOfContents from "./table-of-contents.astro";

// The table of contents on narrow screens: a floating button that opens it in a drawer.
type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;
---

<toc-drawer class={drawer.host}>
  <button data-part="trigger" class={drawer.button} aria-label="Table of Contents" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="toc-drawer" data-state="closed"><Icon name="List" size={24} /></button>
  <template data-part="layer">
    <span data-part="guard" tabindex="0" aria-hidden="true" class={drawer.guard}></span>
    <div data-part="overlay" data-state="open" class={drawer.overlay}></div>
    <dialog id="toc-drawer" data-part="content" data-state="open" aria-labelledby="toc-drawer-title" tabindex="-1" class={drawer.content}>
      <div class={drawer.panel}>
        <div aria-hidden="true" class={drawer.handle}></div>
        <div class={drawer.body}>
          <h2 id="toc-drawer-title" class={drawer.title}>Table of Contents</h2>
          <div class={drawer.scroll}><TableOfContents headings={headings} /></div>
        </div>
      </div>
    </dialog>
    <span data-part="guard" tabindex="0" aria-hidden="true" class={drawer.guard}></span>
  </template>
</toc-drawer>

<script>
  import "./toc-drawer.client";
</script>
