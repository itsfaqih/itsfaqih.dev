---
import type { MarkdownHeading } from "astro";
import Icon from "../components/icon.astro";
import { styles } from "./post.css";
import TableOfContents from "./table-of-contents.astro";

// The table of contents on narrow screens: a floating button that opens it in a drawer.
type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;
---

<toc-drawer class={styles.drawerHost}>
  <button data-part="trigger" class={styles.tocButton} aria-label="Table of Contents" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="toc-drawer" data-state="closed"><Icon name="List" size={24} /></button>
  <template data-part="layer">
    <span data-part="guard" tabindex="0" aria-hidden="true" class={styles.guard}></span>
    <div data-part="overlay" data-state="open" class={styles.overlay}></div>
    <dialog id="toc-drawer" data-part="content" data-state="open" aria-labelledby="toc-drawer-title" tabindex="-1" class={styles.drawer}>
      <div class={styles.drawerPanel}>
        <div aria-hidden="true" class={styles.handle}></div>
        <div class={styles.drawerBody}>
          <h2 id="toc-drawer-title" class={styles.drawerTitle}>Table of Contents</h2>
          <div class={styles.drawerScroll}><TableOfContents headings={headings} /></div>
        </div>
      </div>
    </dialog>
    <span data-part="guard" tabindex="0" aria-hidden="true" class={styles.guard}></span>
  </template>
</toc-drawer>

<script>
  import "./toc-drawer.client";
</script>
