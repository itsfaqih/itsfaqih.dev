---
import { HINT } from "./hints";
import DialogBox from "./dialog-box.astro";
import DialogClose from "./dialog-close.astro";
import { styles } from "./dialog-design.css";
import DialogKey from "./dialog-key.astro";
import DialogWindow from "./dialog-window.astro";
import { host } from "./rule-landing.css";

type Props = { sealed?: boolean };

const { sealed = false } = Astro.props;
---

<dialog-escape class={host.contents} data-sealed={sealed ? "" : undefined}>
  <DialogWindow>
    <div slot="page" class={styles.page} data-part="page">
      <div class={styles.spread}><span class={styles.logo}></span><button data-hint={HINT.open} type="button" data-stop="trigger" class:list={[styles.stop, styles.pill]}>What's new</button></div>
      {
        [72, 54, 64, 46].map((width) => (
          <div class={styles.mail}><span class={styles.dot}></span><span style={`--w:${width}%`} class={styles.ghost}></span></div>
        ))
      }
    </div>
    <DialogBox id={`escape-${sealed ? "good" : "bad"}-`} title="What's new in 2.4" body="Threads fold up, and search now finds attachments." part="dialog">
      <DialogClose slot="close" />
      <div class={styles.acts}><button type="button" data-stop="ok" class:list={[styles.stop, styles.btn]}>Got it</button></div>
    </DialogBox>
    <DialogKey slot="keys" part="esc">Esc</DialogKey>
    <Fragment slot="read">Open What's new, then press Esc</Fragment>
  </DialogWindow>
</dialog-escape>
