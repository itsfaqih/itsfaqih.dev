---
import Code from "./code.astro";
import TsPaint from "./ts-paint.astro";
import { styles } from "./typescript-code-writing.styles";
import type { Tone } from "./rule-landing.styles";

type Props = { text: string; tone?: Tone };

const { text, tone = "plain" } = Astro.props;
---

<Code tone={tone} style={styles.boardCode}><TsPaint text={text} /></Code>
