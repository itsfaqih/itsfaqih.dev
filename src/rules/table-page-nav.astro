---
import * as stylex from "@stylexjs/stylex";
import Icon from "../components/icon.astro";
import { styles, view } from "./table-design.styles";

type Props = { page: number; pages: number };

const { page, pages } = Astro.props;
---

<nav {...stylex.attrs(styles.pager)} aria-label="Pages" data-part="nav"
  ><span>Page <!-- -->{page}<!-- --> of <!-- -->{pages}</span><span {...stylex.attrs(styles.pages)}
    ><button
      type="button"
      aria-label="Previous page"
      disabled={page <= 1}
      {...stylex.attrs(styles.page, styles.ring)}
      data-step="-1"
      ><Icon
        name="CaretLeft"
        size="1em"
        weight="bold"
        aria-hidden="true"
        {...stylex.attrs(styles.pageIcon)}
      /></button
    >{
      Array.from({ length: pages }, (_, at) => at + 1).map((n) => (
        <button
          type="button"
          aria-current={n === page ? "page" : undefined}
          class={view.pageKey(n === page)}
          data-page={n}>{n}</button
        >
      ))
    }<button
      type="button"
      aria-label="Next page"
      disabled={page >= pages}
      {...stylex.attrs(styles.page, styles.ring)}
      data-step="1"
      ><Icon
        name="CaretRight"
        size="1em"
        weight="bold"
        aria-hidden="true"
        {...stylex.attrs(styles.pageIcon)}
      /></button
    ></span
  ></nav
>
