---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./dialog-design.styles";

type Props = { part: string; hint?: boolean };

const { part, hint = false } = Astro.props;
---

<button type="button" data-hint={hint ? "true" : undefined} {...stylex.attrs(styles.key)} data-part={part}><slot /></button>
