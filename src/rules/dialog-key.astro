---
import { hoverHold } from "../components/hover-hold.css";
import { HINT } from "./hints";
import { styles } from "./dialog-design.css";

type Props = { part: string; hint?: boolean };

const { part, hint = false } = Astro.props;
---

<button type="button" data-hint={hint ? HINT.press : undefined} class:list={[hoverHold.lift, styles.key]} data-part={part}><slot /></button>
