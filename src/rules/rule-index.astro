---
import * as stylex from "@stylexjs/stylex";
import { TOPICS, VISIBLE_GUIDELINES as RULES } from "../data/guidelines";
import { arcade } from "../components/arcade";
import { loadIn } from "../components/load-in";
import Backdrop from "../sections/backdrop.astro";
import { heroType } from "../sections/hero-type";
import RuleSelect from "../sections/rule-select.astro";
import { veil } from "../sections/section";
import { styles } from "./rule-index.styles";

type Props = {
  /** The line under the title, which is also the page's description. */
  lede: string;
};

const { lede } = Astro.props;
const words = stylex.attrs(loadIn.piece, loadIn.words);
---

<rule-index class={`arc ${stylex.attrs(arcade.root, arcade.scan, styles.root).class}`}>
  <Backdrop tide />
  <div {...stylex.attrs(arcade.wrap)}>
    <div {...stylex.attrs(styles.head)}>
      <div {...stylex.attrs(loadIn.veil, veil.dense, veil.fit, heroType.tag)} data-cut="true"
        ><span {...words} data-cut="true">{RULES.length} rules · {TOPICS.length} topics</span></div
      >
      <h1
        data-cut="true"
        {...stylex.attrs(loadIn.veil, veil.soft, veil.fit, heroType.title, styles.title)}
        ><span {...words} data-cut="true">Rule of Thumb</span></h1
      >
      <p data-cut="true" {...stylex.attrs(loadIn.veil, veil.soft, veil.fit, styles.lede)}
        ><span {...words} data-cut="true">{lede}</span></p
      >
    </div>
    <div {...stylex.attrs(styles.body)}>
      <RuleSelect />
    </div>
  </div>
</rule-index>

<script>
  import "./rule-index.client";
</script>
