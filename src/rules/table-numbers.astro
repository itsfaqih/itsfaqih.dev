---
import { arcade } from "../components/arcade.css";
import { ACCOUNTS, DIGITS, MRR, money } from "./table-design";
import { styles } from "./table-design.css";
import { view } from "./table-design.view";

type Props = { careful: boolean };

const { careful } = Astro.props;
---

<table-numbers class={styles.card} data-careful={careful ? "true" : undefined}>
  <table class={styles.table}>
    <caption class={arcade.srOnly}>Monthly revenue by account</caption>
    <colgroup><col /><col class={styles.colMoney} /></colgroup>
    <thead>
      <tr
        ><th scope="col" class={styles.th}>Account</th><th
          scope="col"
          class:list={[styles.th, careful && styles.num]}>MRR ($)</th
        ></tr
      >
    </thead>
    <tbody class={styles.body}>
      {
        ACCOUNTS.map((account, at) => {
          const value = MRR[at] ?? 0;
          return (
            <tr class={view.row}
              ><td class={styles.td}>{account}</td><td
                class:list={[styles.td, careful ? styles.num : styles.ragged]}
                >{
                  careful ? (
                    <Fragment
                      ><span class={arcade.srOnly}>{money(value)}</span><span
                        class={styles.reels}
                        aria-hidden="true"
                        >{[...money(value)].map((char) =>
                          /\d/.test(char) ? (
                            <span class={view.reel}
                              ><span class={view.strip} style={`--n:${char}`}
                                >{DIGITS.map((digit) => <span class={view.digit}>{digit}</span>)}</span
                              ></span
                            >
                          ) : (
                            <span>{char}</span>
                          ),
                        )}</span
                      ></Fragment
                    >
                  ) : (
                    String(value)
                  )
                }</td
              ></tr
            >
          );
        })
      }
    </tbody>
  </table>
</table-numbers>

<script>
  import "./table-design.client";
</script>
