---
import Code from "./code.astro";
import TsPaint from "./ts-paint.astro";
import { styles } from "./typescript-code-writing.css";
import type { Tone } from "./rule-landing.view";

// A slot label that reads dim until the slot opens.
type Props = { text: string; tone: Tone };

const { text, tone } = Astro.props;
---

<Code tone={tone} class={[styles.boardCode, styles.holds]}><TsPaint text={text} /></Code>
