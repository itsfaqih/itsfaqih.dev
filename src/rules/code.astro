---
import * as stylex from "@stylexjs/stylex";
import { codeTone, type Tone } from "./rule-landing.styles";

type Props = {
  /** Where the code sits: "chip" in lesson copy, "prompt" in a quiz prompt, "wrap" elsewhere. */
  tone?: Tone;
  style?: stylex.StyleXStyles;
};

const { tone = "plain", style } = Astro.props;
---

<code {...stylex.attrs(codeTone(tone), style)}><slot /></code>
