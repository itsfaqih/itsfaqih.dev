---
import { arcade } from "../components/arcade.css";
import {
  dayOf,
  hourAngle,
  minuteAngle,
  offBy,
  timeOf,
  type Reading,
  type Wall,
} from "./handling-timestamps";
import { styles } from "./handling-timestamps.css";
import { tsView } from "./handling-timestamps.view";
import { host } from "./rule-landing.css";

type Props = {
  readings: Reading[];
  /** The UTC moment the clocks swing from as they come on screen. */
  utc: Wall;
};

const { readings, utc } = Astro.props;
---

<ts-readers
  class={host.contents}
  data-times={readings.map((reading) => reading.shown).join()}
  data-utc={utc}
>
  <div class={styles.readers}>
    {
      readings.map((reading) => {
        const off = offBy(reading);
        return (
          <div class={`ts-reader ${styles.reader}`}
            ><span aria-hidden="true" class={styles.clock}
              >{off && <i class={tsView.ghost} style={`--a:${hourAngle(reading.truth)}deg`} />}<i
                class={tsView.minute}
                style={`--a:${minuteAngle(reading.shown)}deg`}
              /><i class={tsView.hour(off !== null)} style={`--a:${hourAngle(reading.shown)}deg`} /></span
            ><span class={styles.read}
              ><span class={styles.who}
                >{reading.person.who}<Fragment set:html="<!-- -->" /> · <Fragment set:html="<!-- -->" />{
                  reading.person.city
                }</span
              ><b class={tsView.time(off !== null)}>{timeOf(reading.shown)}</b><span class={styles.date}
                >{dayOf(reading.shown)}</span
              >{
                off && (
                  <span class={styles.should}
                    ><span class={arcade.srOnly}>{off}<Fragment set:html="<!-- -->" />, </span>should be<Fragment
                      set:html="<!-- -->"
                    /> <Fragment set:html="<!-- -->" />{timeOf(reading.truth)}</span
                  >
                )
              }</span
            ></div
          >
        );
      })
    }
  </div>
</ts-readers>

<script>
  import "./ts-readers.client";
</script>
