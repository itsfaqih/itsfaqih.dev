---
import * as stylex from "@stylexjs/stylex";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { Level } from "./lesson";
import { host, lessonKit, quizKit, quizView, shell, tree } from "./rule-landing.styles";

/**
 * Draws a row's string as markup, from props `text` and `tone` (how code reads where it lands: "wrap"
 * inside a slot button, "plain" elsewhere). A text row's mark also gets the whole `row`.
 */
type Mark = AstroComponentFactory;

type Props = {
  /** The level's number across the page, for its `lv-N` anchor. */
  n: number;
  level: Level;
  board?: string;
  /** For rows that carry markup, such as painted code: what draws each lead, slot label and text row. */
  marks?: { lead?: Mark; label?: Mark; text?: Mark };
};

const { n, level, board = "board", marks = {} } = Astro.props;
const { lead: Lead, label: Label, text: Text } = marks;
const idle = { open: false, near: false, missed: false, cleared: false, seated: false };
const place = "piece" in level ? level : null;
const hint = place
  ? `Drag the piece into the ${board}. Or tap it, then tap a spot.`
  : "Tap the one that fits.";
---

<rule-quiz
  {...stylex.attrs(host.contents)}
  data-answer={level.answer}
  data-piece={place?.piece}
  data-board={board}
  data-hint={hint}
>
  <article id={`lv-${n}`} {...stylex.attrs(lessonKit.panel, quizKit.level, shell.rev)} data-rev="true">
    <div {...stylex.attrs(quizKit.copy)}>
      <div {...stylex.attrs(quizKit.levelHead)} data-part="head">
        <span {...stylex.attrs(quizKit.badge)}>Quiz</span>
      </div>
      <h3 {...stylex.attrs(quizKit.title)}>{level.name}</h3>
      <p {...stylex.attrs(quizKit.prompt)}><slot /></p>
      <div aria-live="polite" class={quizView.say(false, false)} data-part="say">
        <p class={quizView.said(false)}>{hint}</p>
      </div>
    </div>

    <div {...stylex.attrs(lessonKit.well, quizKit.board, !place && quizKit.chooseBoard)}>
      {
        place ? (
          <Fragment>
          <ul {...stylex.attrs(tree.list)}>
            {
              place.rows.map((row) =>
                "slot" in row ? (
                  <li style={`--d:${row.depth}`} {...stylex.attrs(tree.row, row.lead ? quizKit.leadRow : null)}
                    >{row.lead && <span {...stylex.attrs(quizKit.lead)}>{Lead ? <Lead text={row.lead} tone="plain" /> : row.lead}</span>}<button
                      type="button"
                      class={quizView.slot({ ...idle, lead: row.lead !== undefined })}
                      disabled
                      data-slot={row.slot.id}
                      data-note={row.slot.note}
                      data-part="slot">{Label ? <Label text={row.slot.label} tone="wrap" /> : row.slot.label}</button
                    ></li
                  >
                ) : (
                  <li style={`--d:${row.depth}`} {...stylex.attrs(tree.row, row.kind && tree[row.kind])}
                    >{Text ? <Text text={row.text} tone="plain" row={row} /> : row.text}{row.tag && <span {...stylex.attrs(tree.calls)}>{row.tag}</span>}</li
                  >
                ),
              )
            }
          </ul>
          <div {...stylex.attrs(quizKit.tray)}>
            <button
              type="button"
              class={quizView.piece(false, false)}
              aria-pressed="false"
              aria-label={`${place.piece}. Pick up`}
              data-part="piece">{place.piece}</button
            ><span {...stylex.attrs(quizKit.trayNote)} data-part="note">Your piece</span>
          </div>
          </Fragment>
        ) : (
          <slot name="board" />
        )
      }
    </div>
  </article>
  <template data-part="seat"
    ><span {...stylex.attrs(place ? [quizKit.piece, quizKit.seated] : quizKit.tick)}
      >{place ? place.piece : "✓"}<span aria-hidden="true" {...stylex.attrs(quizKit.burst)}
        >{
          Array.from({ length: 8 }, (_, index) => (
            <i style={`--a:${index * 45 + 22}deg`} {...stylex.attrs(quizKit.spark)} />
          ))
        }</span
      ></span
    ></template
  >
  <template data-part="clear"
    ><span {...stylex.attrs(quizKit.stamp)}>Clear</span><span {...stylex.attrs(quizKit.stars)}
      >{[1, 2, 3].map(() => <i class={quizView.star(false)}>★</i>)}</span
    ></template
  >
</rule-quiz>

<script>
  import "./rule-quiz.client";
</script>
