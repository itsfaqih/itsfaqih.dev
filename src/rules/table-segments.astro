---
import * as stylex from "@stylexjs/stylex";
import { styles, view } from "./table-design.styles";

type Props = {
  label: string;
  options: readonly (readonly [string, string])[];
  value: string;
  /** The page store the segments pick a value of. */
  of: "roster" | "filter";
};

const { label, options, value, of } = Astro.props;
---

<table-segments {...stylex.attrs(styles.seg)} role="group" aria-label={label} data-hint="true" data-of={of}
  >{
    options.map(([key, name]) => (
      <button type="button" aria-pressed={value === key ? "true" : "false"} class={view.segKey(value === key)} data-key={key}
        >{name}</button
      >
    ))
  }</table-segments
>

<script>
  import "./table-design.client";
</script>
