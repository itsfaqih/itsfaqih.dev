---
import { cx } from "../cx";
import {
  colorOf,
  PUBLISHED_GUIDELINES,
  ruleNumber,
  VISIBLE_GUIDELINES,
} from "../data/guidelines";
import Icon from "../components/icon.astro";
import { arcade } from "../components/arcade.css";
import { button } from "../components/button.css";
import { buttonVariant } from "../components/button";
import Backdrop from "../sections/backdrop.astro";
import { heroType } from "../sections/hero-type.css";
import { reticle } from "../sections/reticle.css";
import RuleThumb from "../sections/rule-thumb.astro";
import { section, veil } from "../sections/section.css";
import Code from "./code.astro";
import type { Tldr } from "./lesson";
import PagerCard from "./pager-card.astro";
import { reveal } from "./rule-landing.vars.css";
import { cover, host, island, lessonKit, pager, shell, takeKit } from "./rule-landing.css";
import { landingView } from "./rule-landing.view";
import { titleWordEm } from "./title-fit";
import ShareButton from "./share-button.astro";

type Props = {
  /** The published rule this page teaches. */
  id: string;
  /** The heading over the lessons; its intro goes in the "intro" slot. */
  learn: string;
  tldr: Tldr;
  /** What agents do with the rule in their `AGENTS.md`, as in "build buttons the same way". */
  take: string;
};

const { id, learn, tldr, take } = Astro.props;
const rule = PUBLISHED_GUIDELINES.find((guideline) => guideline.id === id);
if (!rule) throw new Error(`No published rule "${id}"`);

const hue = `--c:${colorOf(rule.label)}`;
const number = ruleNumber(rule);
const markdownUrl = `${rule.href}.md`;
const words = rule.title.split(" ");
const last = words.pop();
const head = words.join(" ");
const at = VISIBLE_GUIDELINES.indexOf(rule);
const prev = VISIBLE_GUIDELINES[at - 1];
const next = VISIBLE_GUIDELINES[at + 1];
const [was, now] = rule.coverTag.split(" → ");
---

<rule-landing
  class={`arc ${cx(arcade.root, arcade.scan, shell.root, reveal, host.block)}`}
  style={hue}
  data-title={rule.title}
  data-claim={rule.claim}
  data-markdown={markdownUrl}
>
  <Backdrop tide />
  <header class:list={[arcade.wrap, shell.titleScreen]}>
    {/* Spans both columns, so Share sits over the cover's right edge. */}
    <div class={shell.crumbRow} data-header-fold>
      <nav
        class:list={[heroType.tag, veil.dense, shell.crumb, shell.in, shell.first]}
        aria-label="Breadcrumb"
        ><a href="/rule-of-thumb" class={shell.crumbLink}>← All rules</a>{
          number && <span class={shell.crumbTag}>No.<!-- -->{number}</span>
        }<span class={shell.crumbTag}>{rule.label}</span></nav
      >
      <ShareButton />
    </div>
    <div class:list={[veil.soft, shell.heroCopy]}>
      <div class={shell.titleFit}>
        <h1
          class:list={[heroType.title, shell.title]}
          style={`--word-em: ${titleWordEm(rule.title)}`}
          data-part="title"
          >{
            head && (
              <Fragment>
                <span class={shell.titleLine}>{head}</span>{" "}
              </Fragment>
            )
          }<span class={shell.titleLine}
            ><span class:list={[heroType.hl, shell.titleMark]}>{last}</span></span
          ></h1
        >
      </div>
      <p class:list={[shell.claim, shell.in, shell.second]}>{rule.claim}</p>
      <p class:list={[heroType.lead, shell.lead, shell.in, shell.third]}><slot name="lead" /></p>
    </div>
    <div class:list={[cover.box, shell.in, shell.coverIn, shell.third]} data-part="cover">
      <div class={cover.card}>
        <div class={cover.sheet}>
          <RuleThumb rule={rule} play at="cover" class={cover.thumb} />
          <div class={cover.tear}></div>
          <div aria-hidden="true" class={cover.stub}>
            <span class={cover.was}>{was}</span><span class={cover.to}
              >→</span
            ><span class={cover.now}>{now}</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class={arcade.wrap}>
    <section
      id="learn"
      aria-labelledby="learn-title"
      class:list={[section.block, lessonKit.section]}
    >
      <div class:list={[lessonKit.secHead, shell.rev]} data-rev="true">
        <h2
          id="learn-title"
          class:list={[section.title, veil.soft, lessonKit.headItem, lessonKit.secTitle]}
        >
          {learn}
        </h2>
        <p class:list={[veil.soft, lessonKit.headItem, lessonKit.secText]}><slot name="intro" /></p>
      </div>
      <div class={lessonKit.lessons}>
        <slot />
      </div>
      <div class:list={[lessonKit.sheetWrap, shell.rev]} data-rev="true">
        <h3 class:list={[veil.soft, lessonKit.sheetTitle]}>TL;DR</h3>
        <ol class:list={[lessonKit.panel, lessonKit.sheet]}>
          {
            tldr.map(([situation, answer]) => (
              <li class={lessonKit.sheetRow}
                ><span class={lessonKit.situation}>{situation}</span><b
                  class={lessonKit.answer}>{answer}</b
                ></li
              >
            ))
          }
        </ol>
      </div>
    </section>

    <section class:list={[section.block, takeKit.section]}>
      <div class:list={[veil.soft, takeKit.copy, shell.rev]} data-rev="true">
        <h2 class:list={[section.title, takeKit.title]}>Take the rule with you</h2>
        <p class={takeKit.text}
          >The whole rule in Markdown. Paste it into your <Code tone="take">AGENTS.md</Code>{
            ` and your agents will ${take}.`
          }</p
        >
        <div class:list={[heroType.acts, takeKit.acts]}>
          <button
            type="button"
            class:list={[button.base, buttonVariant["primary-brand"]]}
            data-part="copy">Copy as Markdown</button
          >
          <a
            class:list={[button.base, buttonVariant["secondary-brand"]]}
            href={markdownUrl}
            target="_blank"
            rel="noopener noreferrer">View .md</a
          >
        </div>
      </div>
      <div class={shell.rev} data-rev="true">
        {
          at !== -1 && (
            <nav class:list={[arcade.root, pager.nav]} aria-label="More rules">
              {prev ? (
                <PagerCard rule={prev} direction="Previous" />
              ) : (
                <div class={pager.gap} />
              )}
              {next ? (
                <PagerCard rule={next} direction="Next" />
              ) : (
                <a
                  href="/rule-of-thumb"
                  class:list={[reticle.card, reticle.aim, pager.card, pager.all]}
                  ><span class={pager.dir}>That's every rule so far</span><span
                    class={pager.title}>Back to all rules →</span
                  ></a
                >
              )}
            </nav>
          )
        }
      </div>
    </section>
  </div>
  {/* The compact header island's live activity, moved into its [data-island-activity] on load. */}
  <template data-part="activity"
    ><span class={island.activity} style={hue}
      ><a href="/rule-of-thumb" class:list={[island.action, island.back]}
        ><Icon name="ArrowLeft" size={16} weight="bold" aria-hidden="true" /><span
          class={island.backText}>All rules</span
        ></a
      ><span class={landingView.label} data-part="label"
        ><span class:list={[island.labelPart, island.tags]}
          >{number && <span>No.<!-- -->{number}</span>}<span>{rule.label}</span></span
        ><span aria-hidden="true" class:list={[island.labelPart, island.title]}
          >{head && `${head} `}<span class={heroType.hl}>{last}</span></span
        ></span
      ><ShareButton inIsland /></span
    ></template
  >
</rule-landing>

<script>
  import "./rule-landing.client";
</script>
