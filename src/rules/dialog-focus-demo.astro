---
import * as stylex from "@stylexjs/stylex";
import DialogBox from "./dialog-box.astro";
import { styles } from "./dialog-design.styles";
import DialogField from "./dialog-field.astro";
import DialogKey from "./dialog-key.astro";
import DialogWindow from "./dialog-window.astro";
import { host } from "./rule-landing.styles";

type Props = { sealed?: boolean };

const { sealed = false } = Astro.props;
---

<dialog-focus {...stylex.attrs(host.contents)} data-sealed={sealed ? "" : undefined}>
  <div>
    <DialogWindow>
      <div slot="page" {...stylex.attrs(styles.page, styles.checkout)} data-part="page">
        <div {...stylex.attrs(styles.spread)}><span {...stylex.attrs(styles.logo)}></span><button type="button" data-stop="help" {...stylex.attrs(styles.stop, styles.link)}>Help</button></div>
        <div {...stylex.attrs(styles.card)}><div {...stylex.attrs(styles.spread)}><b {...stylex.attrs(styles.strong)}>Order #2041</b><span {...stylex.attrs(styles.price)}>$86.00</span></div><span style="--w:70%" {...stylex.attrs(styles.ghost)}></span><span style="--w:48%" {...stylex.attrs(styles.ghost)}></span></div>
        <div {...stylex.attrs(styles.row, styles.pay)}><button type="button" data-stop="trigger" {...stylex.attrs(styles.stop, styles.btn, styles.soft)}>Edit profile</button><button type="button" data-stop="pay" {...stylex.attrs(styles.stop, styles.btn)}>Pay now</button></div>
      </div>
      <DialogBox id={`focus-${sealed ? "good" : "bad"}-`} title="Edit profile" part="dialog">
        <DialogField name="name" label="Name" value="Ada Lovelace" />
        <div {...stylex.attrs(styles.acts)}><button type="button" data-stop="cancel" {...stylex.attrs(styles.stop, styles.btn, styles.plain)}>Cancel</button><button type="button" data-stop="save" {...stylex.attrs(styles.stop, styles.btn)}>Save</button></div>
      </DialogBox>
      <Fragment slot="keys"><DialogKey part="tab" hint>Tab</DialogKey><DialogKey part="esc">Esc</DialogKey></Fragment>
      <Fragment slot="read">Focus: <Fragment set:html="<!-- -->" />&lt;body&gt;</Fragment>
    </DialogWindow>
  </div>
</dialog-focus>
