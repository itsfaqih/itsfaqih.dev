---
import * as stylex from "@stylexjs/stylex";
import { arcade } from "../components/arcade";
import { FILTERED, FILTERS, PER_PAGE, START_FILTER } from "./table-design";
import { host } from "./rule-landing.styles";
import { styles, view } from "./table-design.styles";
import TablePageNav from "./table-page-nav.astro";

type Props = { careful: boolean };

const { careful } = Astro.props;
// Picking a filter mounts its table afresh on page 1, from that filter's template.
---

<table-pager {...stylex.attrs(host.contents)} data-careful={careful ? "true" : undefined}>
  {
    ([START_FILTER, ...FILTERS.map(([filter]) => filter)] as const).map((filter, at) => {
      const people = FILTERED[filter];
      const pages = Math.ceil(people.length / PER_PAGE);
      const shown = people.slice(0, PER_PAGE);
      const card = (
        <div {...stylex.attrs(styles.card)} data-part="card">
          <table {...stylex.attrs(styles.table)}>
            <caption {...stylex.attrs(arcade.srOnly)} data-part="caption">Users, page <!-- -->1</caption>
            <colgroup><col /><col {...stylex.attrs(styles.colRole)} /></colgroup>
            <thead>
              <tr
                ><th scope="col" {...stylex.attrs(styles.th)}>Name</th><th scope="col" {...stylex.attrs(styles.th)}
                  >Role</th
                ></tr
              >
            </thead>
            <tbody {...stylex.attrs(styles.body)} data-part="rows">
              {
                shown.length === 0 ? (
                  <tr class={view.row}
                    ><td colspan="2" {...stylex.attrs(styles.td, styles.blank, styles.still)}
                      ><div {...stylex.attrs(styles.said)}
                        ><b {...stylex.attrs(styles.saidTitle)}>No owners</b><span {...stylex.attrs(styles.saidHint)}
                          >Nobody has the Owner role yet.</span
                        ></div
                      ></td
                    ></tr
                  >
                ) : (
                  shown.map((person) => (
                    <tr class={view.row}
                      ><td {...stylex.attrs(styles.td)}>{person.name}</td><td {...stylex.attrs(styles.td, styles.dim)}
                        >{person.role}</td
                      ></tr
                    >
                  ))
                )
              }
            </tbody>
          </table>
          {(!careful || pages > 1) && <TablePageNav page={1} pages={pages} />}
        </div>
      );
      return at === 0 ? card : <template data-filter={filter}>{card}</template>;
    })
  }
  <template data-part="row"
    ><tr class={view.row}
      ><td {...stylex.attrs(styles.td)}></td><td {...stylex.attrs(styles.td, styles.dim)}></td></tr
    ></template
  >
</table-pager>

<script>
  import "./table-design.client";
</script>
