---
import { arcade } from "../components/arcade.css";
import type { Line } from "./null-vs-undefined";
import { KINDS, OUT_KINDS, paint } from "./null-vs-undefined.view";
import { styles } from "./null-vs-undefined.css";

type Props = { lines: Line[] };

const { lines } = Astro.props;
---

<div class={styles.code}>
  {
    lines.map((line) => (
      <div class:list={[styles.line, line.hot && styles.hot]}
        ><code class={styles.source}>{
          line.c
            ? paint(line.c, KINDS).map((part) => (part.class ? <span class={part.class}>{part.text}</span> : part.text))
            : " "
        }</code>{
          line.out && (
            <span
              class:list={[styles.out,
                line.tone === "no" && styles.outNo,
                line.tone === "yes" && styles.outYes]}
              ><span class={arcade.srOnly}>gives </span>{
                paint(line.out, OUT_KINDS).map((part) =>
                  part.class ? <span class={part.class}>{part.text}</span> : part.text,
                )
              }</span
            >
          )
        }</div
      >
    ))
  }
</div>
