---
import * as stylex from "@stylexjs/stylex";
import {
  FATE,
  FILTER_DATE,
  filterLines,
  filterOf,
  hhmm,
  shortDay,
  timeOf,
  type Way,
} from "./handling-timestamps";
import { styles, tsView } from "./handling-timestamps.styles";
import { host } from "./rule-landing.styles";
import TsWire from "./ts-wire.astro";

type Props = { way: Way };

const { way } = Astro.props;
const { from, orders } = filterOf(way, FILTER_DATE);
---

<ts-filter {...stylex.attrs(host.contents)} data-way={way}>
  <div {...stylex.attrs(styles.view)}>
    <label {...stylex.attrs(styles.form)}
      ><span {...stylex.attrs(styles.formHead)}>Rina's orders on</span><input
        data-hint="true"
        type="date"
        required
        {...stylex.attrs(styles.input)}
        value={FILTER_DATE}
      /></label
    >
    <TsWire lines={filterLines(way, from)} />
    <ul {...stylex.attrs(styles.orders)}>
      {
        orders.map((order) => (
          <li class={tsView.order(order.fate)}
            ><span {...stylex.attrs(styles.orderId)}>#<Fragment set:html="<!-- -->" />{order.id}</span><span
              class={tsView.when(order.fate)}
              >{shortDay(order.wall)}<Fragment set:html="<!-- -->" />, <Fragment set:html="<!-- -->" />{
                timeOf(order.wall)
              }<small {...stylex.attrs(styles.utc)}
                >{shortDay(order.instant)}<Fragment set:html="<!-- -->" />, <Fragment set:html="<!-- -->" />{
                  hhmm(order.instant)
                }<Fragment set:html="<!-- -->" /> UTC</small
              ></span
            >{FATE[order.fate] && <span class={tsView.fate(order.fate)}>{FATE[order.fate]}</span>}</li
          >
        ))
      }
    </ul>
  </div>
</ts-filter>

<script>
  import "./ts-filter.client";
</script>
