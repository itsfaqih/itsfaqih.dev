---
import { EARLY, LATE, LESSONS, ORDERS, TLDR } from "./data-loading";
import { quiz, styles } from "./data-loading.css";
import { view } from "./data-loading.view";
import { quizKit } from "./rule-landing.css";
import DataLoadingFix from "./data-loading-fix.astro";
import DataLoadingInbox from "./data-loading-inbox.astro";
import DataLoadingParse from "./data-loading-parse.astro";
import DataLoadingSlide from "./data-loading-slide.astro";
import DataLoadingRevenue from "./data-loading-revenue.astro";
import DataLoadingSearch from "./data-loading-search.astro";
import DataLoadingSeo from "./data-loading-seo.astro";
import DataLoadingSkeleton from "./data-loading-skeleton.astro";
import DataLoadingTeam from "./data-loading-team.astro";
import DataLoadingWallet from "./data-loading-wallet.astro";
import DataLoadingWaterfall from "./data-loading-waterfall.astro";
import LessonText from "./lesson-text.astro";
import QuizChoice from "./quiz-choice.astro";
import RuleLanding from "./rule-landing.astro";
import RuleLesson from "./rule-lesson.astro";
import RuleQuiz from "./rule-quiz.astro";

const [seo, early, stale, flicker, debounce, errors, boundary, persist] = LESSONS;
const PAGES = [
  ["settings", "Settings, signed in", "Settings", "Signed in", [["Email alerts", "On"], ["Theme", "Dark"]]],
  ["help", "Public help page", "shop.test/help", "Public", [["Return window", "30 days"], ["Refund in", "5 days"]]],
  ["admin", "Staff dashboard", "Admin", "Staff only", [["Orders", "1,284"], ["Refunds", "12"]]],
] as const;
const PRICES = [
  ["Gold", "$2,384"],
  ["Silver", "$28.40"],
] as const;
const TILES = [
  ["Orders", "1,284"],
  ["Visitors", "18.2k"],
  ["Refunds", "12"],
  ["Signups", "342"],
] as const;
const PATH = [
  ["fetch", "loadOrder()", "Receives the order and hands it to the app"],
  ["page", "renderCheckout()", "Renders the order"],
  ["receipt", "printReceipt(order)", "Reads order.coupon.code and throws"],
] as const;
const CACHED = [
  ["stock", "Fan stock", [["Floor fan", "3 left"], ["Desk fan", "8 left"]]],
  ["orders", "Your orders", ORDERS.slice(0, 2).map(({ item, total }) => [item, total])],
  ["price", "Fan sale prices", [["Floor fan", "$39"], ["Desk fan", "$24"]]],
] as const;
---

<RuleLanding id="data-loading" learn="Fast first paint, smooth updates" tldr={TLDR} take="load data the same way">
  <Fragment slot="lead">Start requests on navigation and keep stale data on screen. Show a skeleton only after 200ms.</Fragment>
  <Fragment slot="intro">Design the wait, because people judge loading by what they see while it lasts.</Fragment>

  <RuleLesson lesson={seo}>
    <Fragment slot="body"
      >Render a page that needs search traffic or a fast first paint on the server, so the first HTML response carries the content. A page rendered in the browser sends an empty shell and paints nothing until its code loads and fetches. Many crawlers and link previews read only that first response. A page behind a login never shows up in search, so the browser is fine there.</Fragment
    >
    <DataLoadingSeo slot="bad" />
    <DataLoadingSeo slot="good" server />
  </RuleLesson>
  <RuleQuiz n={1} level={seo.levels[0]}
    >A shop has three pages. Which of these pages must render on the server?
    <div slot="board" class={quizKit.trio}>
      {
        PAGES.map(([id, caption, head, tag, rows]) => (
          <QuizChoice level={seo.levels[0]} id={id} caption={caption}
            ><span class={quiz.prices}
              ><span class={styles.head}>{head}</span><span class={quiz.rows}
                >{
                  rows.map(([name, value]) => (
                    <span class={quiz.row}
                      ><span>{name}</span><b class={styles.histAmount}>{value}</b></span
                    >
                  ))
                }</span
              ><span class={styles.status}>{tag}</span></span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={early}>
    <Fragment slot="body"
      >Fetch on navigation, not on render. A fetch that starts when the page renders waits for the page's code to load and render first. Start it as the user navigates, so it runs while the code loads. Wait for what the page needs and stream the rest.</Fragment
    >
    <DataLoadingWaterfall slot="bad" {...LATE} />
    <DataLoadingWaterfall slot="good" {...EARLY} />
  </RuleLesson>
  <RuleQuiz n={2} level={early.levels[0]} hint="Drag the amber bar, then press Check. Arrow keys work too."
    >The invoices page lists 12 invoices. Drag <b>GET /invoices</b> to when it should start. The rows render once both the code and the data are in.
    <DataLoadingSlide slot="board" level={early.levels[0]} />
  </RuleQuiz>

  <RuleLesson lesson={stale}>
    <Fragment slot="body"
      >When you refetch data you already have, show a small spinner beside it and swap the new value in place. Press Refetch on both.</Fragment
    >
    <DataLoadingRevenue slot="bad" />
    <DataLoadingRevenue slot="good" swr />
  </RuleLesson>
  <RuleQuiz n={3} level={stale.levels[0]}
    >You return to a tab of prices loaded 5 minutes ago. They refetch on focus, which takes a few seconds. Pick what the tab shows meanwhile.
    <div slot="board" class={quizKit.trio}>
      <QuizChoice level={stale.levels[0]} id="blank" caption="A full spinner"
        ><span class={quiz.prices}
          ><span class={styles.head}>Prices</span><span class:list={[styles.spin, quiz.bigSpin]}
          ></span><span class={styles.status}>Updating</span></span
        ></QuizChoice
      >
      {
        (
          [
            ["stay", "A small spinner beside them", true],
            ["keep", "Kept until the next load", false],
          ] as const
        ).map(([id, caption, spin]) => (
          <QuizChoice level={stale.levels[0]} id={id} caption={caption}
            ><span class={quiz.prices}
              ><span class={styles.head}>Prices</span><span class={quiz.rows}
                >{
                  PRICES.map(([name, price]) => (
                    <span class={quiz.row}
                      ><span>{name}</span><b class={styles.histAmount}>{price}</b></span
                    >
                  ))
                }</span
              ><span class={styles.status}
                >{spin && <span class:list={[styles.spin, styles.spinSmall]} />}{
                  spin ? "Updating" : "Updated 5 min ago"
                }</span
              ></span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={flicker}>
    <Fragment slot="body"
      >Most replies are quick. Show loading UI only after 200ms, so a fast reply appears without a skeleton flash.</Fragment
    >
    <DataLoadingInbox slot="bad" />
    <DataLoadingInbox slot="good" delay />
  </RuleLesson>
  <RuleQuiz n={4} level={flicker.levels[0]} hint="Drag the skeleton, then press Check. Arrow keys work too."
    >Search suggestions load as you type. Most replies are fast and a few are slow. Drag the skeleton to when it should appear.
    <DataLoadingSkeleton slot="board" level={flicker.levels[0]} />
  </RuleQuiz>

  <RuleLesson lesson={debounce}>
    <Fragment slot="body"
      >A search box that sends a request on every keystroke floods the server, and a slow reply for an old query can land after the newest one. Wait for a pause in typing, then send one request, and cancel the one in flight when a new one starts. This is debouncing. Press Type lamp on both.</Fragment
    >
    <DataLoadingSearch slot="bad" />
    <DataLoadingSearch slot="good" debounce />
  </RuleLesson>
  <RuleQuiz n={5} level={debounce.levels[0]} hint="Tap a fix."
    >You type ch, pause, add ai, pause, then finish chair. This box sends 5 requests and shows results for chai. Pick the setup that sends fewer and shows chair's results.
    <DataLoadingFix slot="board" level={debounce.levels[0]} />
  </RuleQuiz>

  <RuleLesson lesson={errors}>
    <Fragment slot="body"
      >Show the error where the data would go, with a Retry button. A toast fades before anyone reads it and leaves an empty card. Log every failure so you learn about it before a user reports it.</Fragment
    >
    <DataLoadingTeam slot="bad" />
    <DataLoadingTeam slot="good" inline />
  </RuleLesson>
  <RuleQuiz n={6} level={errors.levels[0]}
    >A dashboard loads five cards, and the revenue card fails to load. Tap where its error and Retry should go.
    <div slot="board" class={quiz.screen}>
      <span class={quiz.backdrop}><QuizChoice level={errors.levels[0]} id="page" look="spot" /></span>
      <span class:list={[styles.head, quiz.through]}
        ><span>Dashboard</span><span class={styles.status}>4 of 5 loaded</span></span
      >
      <span class:list={[quiz.tiles, quiz.through]}>
        <span class={quiz.wide}
          ><QuizChoice level={errors.levels[0]} id="inline" look="spot"
            ><span class={quiz.tile}
              ><span class={quiz.tileLabel}>Revenue, this week</span><span class={quiz.missingChart}
              ></span></span
            ></QuizChoice
          ></span
        >
        {
          TILES.map(([label, value]) => (
            <span class={quiz.tile}
              ><span class={quiz.tileLabel}>{label}</span><b class={quiz.tileValue}>{value}</b></span
            >
          ))
        }
      </span>
      <span class={quiz.toastSpot}
        ><QuizChoice level={errors.levels[0]} id="toast" look="spot"
          ><span class:list={[styles.toast, quiz.toast]}>Something went wrong</span></QuizChoice
        ></span
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={boundary}>
    <Fragment slot="body"
      >API data is a guess until you check it. Parse it as soon as it arrives and give optional fields a fallback, so the rest of your code gets real types. If you skip it, a missing field crashes far from where it came in.</Fragment
    >
    <LessonText slot="extra" tip
      >When a required field fails, show a plain message and log the details. Update the schema when the API changes. It documents the API too.</LessonText
    >
    <DataLoadingParse slot="bad" />
    <DataLoadingParse slot="good" parse />
  </RuleLesson>
  <RuleQuiz n={7} level={boundary.levels[0]} hint="Tap a step."
    >An order arrives without its coupon, and the receipt crashes. Tap where the fix goes.
    <div slot="board" class={quiz.path}>
      <span class={quiz.response}
        ><b class={quiz.nodeName}>GET /orders/1042</b><span class={quiz.json}
          >{'{ "id": 1042, "total": 24, '}<span class={quiz.hole}>coupon?</span>{" }"}</span
        ></span
      >
      {
        PATH.map(([id, name, does]) => (
          <Fragment
            ><i aria-hidden="true" class={quiz.link}></i><QuizChoice level={boundary.levels[0]} id={id} look="spot"
              ><span class={quiz.node}
                ><b class={quiz.nodeName}>{name}</b><span class={quiz.nodeDoes}>{does}</span></span
              ></QuizChoice
            ></Fragment
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={persist}>
    <Fragment slot="body"
      >A disk cache is already old when the app next opens. Persist history, settings and static content, and show when it was updated. Never persist balances, prices or stock counts. A stale number there leads to a wrong decision.</Fragment
    >
    <DataLoadingWallet slot="bad" />
    <DataLoadingWallet slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={8} level={persist.levels[0]}
    >A shop app persists its cache. On day 2 both fans sell out and their sale ends. On day 3 you open the app with no signal. Tap what it may show from the cache.
    <div slot="board" class:list={[styles.card, quiz.wallet]}>
      <span class={styles.head}
        ><span>Shop</span><span class={view.signal("offline")}>No signal, day 3</span></span
      >
      {
        CACHED.map(([id, head, rows]) => (
          <QuizChoice level={persist.levels[0]} id={id} look="spot"
            ><span class:list={[styles.hist, quiz.inset]}
              ><span class={styles.histHead}
                ><span>{head}</span><span class={styles.stamp}>Updated 2 days ago</span></span
              ><span class={styles.histList}
                >{
                  rows.map(([name, value]) => (
                    <span class={quiz.row}
                      ><span>{name}</span><b class={styles.histAmount}>{value}</b></span
                    >
                  ))
                }</span
              ></span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>
</RuleLanding>
