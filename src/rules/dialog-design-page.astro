---
import * as stylex from "@stylexjs/stylex";
import Icon from "../components/icon.astro";
import DialogConfirmDemo from "./dialog-confirm-demo.astro";
import { DRAFT, LESSONS, TLDR } from "./dialog-design";
import { quiz, styles } from "./dialog-design.styles";
import { quizKit } from "./rule-landing.styles";
import DialogDraftDemo from "./dialog-draft-demo.astro";
import DialogEscapeDemo from "./dialog-escape-demo.astro";
import DialogFocusDemo from "./dialog-focus-demo.astro";
import DialogNameDemo from "./dialog-name-demo.astro";
import DialogScrollDemo from "./dialog-scroll-demo.astro";
import Kbd from "./kbd.astro";
import LessonText from "./lesson-text.astro";
import RuleLanding from "./rule-landing.astro";
import RuleLesson from "./rule-lesson.astro";
import QuizChoice from "./quiz-choice.astro";
import RuleQuiz from "./rule-quiz.astro";

const [focus, escape, safe, draft, scroll, name] = LESSONS;
const btn = [styles.btn, quiz.key];
const x = { name: "X", size: "1em", weight: "bold", "aria-hidden": "true" } as const;
---

<RuleLanding id="dialog-design" learn="Hold focus, let go cleanly" tldr={TLDR} take="build dialogs the same way">
  <Fragment slot="lead">Trap Tab inside the dialog, lock the page behind it, and name it for screen readers.</Fragment>
  <Fragment slot="intro">Give a dialog a way through and a way out, since it takes over the screen.</Fragment>

  <RuleLesson lesson={focus}>
    <Fragment slot="body">Move focus into the dialog when it opens. Let <Kbd>Tab</Kbd> cycle its controls and never reach the inert page behind. On close, return focus to the button that opened it. Press Tab in both.</Fragment>
    <DialogFocusDemo slot="bad" />
    <DialogFocusDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={1} level={focus.levels[0]}
    >You opened <b>Edit profile</b> from its button halfway down a settings page, then pressed Save. Tap where focus goes.
    <div slot="board" {...stylex.attrs(quiz.screen)}>
      <span {...stylex.attrs(styles.page, quiz.page)}>
        <QuizChoice level={focus.levels[0]} id="body" look="spot"
          ><span {...stylex.attrs(styles.spread)}
            ><span {...stylex.attrs(styles.logo)}></span><span {...stylex.attrs(quiz.nav)}
              >{Array.from({ length: 12 }, () => <span {...stylex.attrs(quiz.navLink)}></span>)}</span
            ></span
          ></QuizChoice
        >
        <b {...stylex.attrs(styles.strong)}>Settings</b>
        <span style="--w:64%" {...stylex.attrs(styles.ghost)}></span>
        <span {...stylex.attrs(styles.card, styles.spread, quiz.wrap)}
          ><span {...stylex.attrs(styles.project)}
            ><b {...stylex.attrs(styles.strong)}>Profile</b><small {...stylex.attrs(styles.meta)}>Ada Lovelace</small></span
          ><QuizChoice level={focus.levels[0]} id="trigger" look="spot"
            ><span {...stylex.attrs(btn, styles.soft, quiz.softInCard)}>Edit profile</span></QuizChoice
          ></span
        >
        <span {...stylex.attrs(styles.card, styles.spread, quiz.wrap)}
          ><span {...stylex.attrs(styles.project)}
            ><b {...stylex.attrs(styles.strong)}>Password</b><small {...stylex.attrs(styles.meta)}>changed 3 months ago</small></span
          ><QuizChoice level={focus.levels[0]} id="next" look="spot"
            ><span {...stylex.attrs(btn, styles.soft, quiz.softInCard)}>Change password</span></QuizChoice
          ></span
        >
        <span style="--w:52%" {...stylex.attrs(styles.ghost)}></span>
        <span style="--w:40%" {...stylex.attrs(styles.ghost)}></span>
      </span>
    </div>
  </RuleQuiz>

  <RuleLesson lesson={escape}>
    <Fragment slot="body">Close every dialog on <Kbd>Esc</Kbd>, every time, since keyboard users leave that way. Let a click outside close an info dialog too, as it has nothing to lose.</Fragment>
    <DialogEscapeDemo slot="bad" />
    <DialogEscapeDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={2} level={escape.levels[0]}
    >Three dialogs, and a click lands on the dim area around each. Pick the one that click should close.
    <div slot="board" {...stylex.attrs(quizKit.trio)}>
      <QuizChoice level={escape.levels[0]} id="issue" caption="Title typed in"
        ><span {...stylex.attrs(quiz.mini)}
          ><span {...stylex.attrs(quiz.miniPanel)}
            ><span {...stylex.attrs(quiz.miniHead)}
              ><span {...stylex.attrs(quiz.miniTitle)}>New issue</span><Icon {...x} {...stylex.attrs(quiz.miniX)} /></span
            ><span {...stylex.attrs(quiz.miniField)}>{DRAFT}</span><span {...stylex.attrs(quiz.miniActs)}
              ><span {...stylex.attrs(quiz.miniBtn)}>Create</span></span
            ></span
          ><span {...stylex.attrs(quiz.click)}><span {...stylex.attrs(quiz.clickDot)}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={escape.levels[0]} id="news" caption="Nothing to fill in"
        ><span {...stylex.attrs(quiz.mini)}
          ><span {...stylex.attrs(quiz.miniPanel)}
            ><span {...stylex.attrs(quiz.miniHead)}
              ><span {...stylex.attrs(quiz.miniTitle)}>What's new</span><Icon {...x} {...stylex.attrs(quiz.miniX)} /></span
            ><span style="--w:92%" {...stylex.attrs(styles.ghost)}></span><span style="--w:64%" {...stylex.attrs(styles.ghost)}></span><span
              {...stylex.attrs(quiz.miniActs)}><span {...stylex.attrs(quiz.miniBtn)}>Got it</span></span
            ></span
          ><span {...stylex.attrs(quiz.click)}><span {...stylex.attrs(quiz.clickDot)}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={escape.levels[0]} id="profile" caption="Nothing changed yet"
        ><span {...stylex.attrs(quiz.mini)}
          ><span {...stylex.attrs(quiz.miniPanel)}
            ><span {...stylex.attrs(quiz.miniHead)}><span {...stylex.attrs(quiz.miniTitle)}>Edit profile</span></span><span
              {...stylex.attrs(quiz.miniField)}>Ada Lovelace</span
            ><span {...stylex.attrs(quiz.miniActs)}
              ><span {...stylex.attrs(quiz.miniBtn, quiz.miniPlain)}>Cancel</span><span {...stylex.attrs(quiz.miniBtn)}>Save</span></span
            ></span
          ><span {...stylex.attrs(quiz.click)}><span {...stylex.attrs(quiz.clickDot)}></span>click</span></span
        ></QuizChoice
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={safe}>
    <Fragment slot="body">Focus a form's first field so people can type at once. Focus Cancel on a confirm that destroys something, so a stray <Kbd>Enter</Kbd> backs out. Open both and press Enter.</Fragment>
    <LessonText slot="extra" tip>Focus the destructive button only where speed matters more and the action can be undone.</LessonText>
    <DialogConfirmDemo slot="bad" />
    <DialogConfirmDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={3} level={safe.levels[0]}
    ><b>Delete Moonbase?</b> removes 214 files for good. Tap where focus starts.
    <div slot="board" {...stylex.attrs(quiz.screen, quiz.tall)}>
      <span {...stylex.attrs(quiz.layer, styles.page, quiz.page)}>
        <span {...stylex.attrs(styles.spread)}><span {...stylex.attrs(styles.logo)}></span><span style="--w:30%" {...stylex.attrs(styles.ghost)}></span></span>
        <span {...stylex.attrs(styles.card, styles.spread, quiz.wrap)}
          ><span {...stylex.attrs(styles.project)}
            ><b {...stylex.attrs(styles.strong)}>Moonbase</b><small {...stylex.attrs(styles.meta)}>214 files · edited 2h ago</small></span
          ><QuizChoice level={safe.levels[0]} id="trigger" look="spot"
            ><span {...stylex.attrs(btn, styles.red, styles.redTint)}>Delete project</span></QuizChoice
          ></span
        >
        <span style="--w:62%" {...stylex.attrs(styles.ghost)}></span>
      </span>
      <span aria-hidden="true" {...stylex.attrs(quiz.layer, quiz.scrim)}></span>
      <span {...stylex.attrs(quiz.layer, quiz.panel, quiz.low)}>
        <span {...stylex.attrs(styles.head)}><span {...stylex.attrs(styles.title)}>Delete Moonbase?</span></span>
        <span {...stylex.attrs(styles.body)}>Its 214 files go too. This can't be undone.</span>
        <span {...stylex.attrs(styles.acts)}
          ><QuizChoice level={safe.levels[0]} id="cancel" look="spot"
            ><span {...stylex.attrs(btn, styles.plain, quiz.plain)}>Cancel</span></QuizChoice
          ><QuizChoice level={safe.levels[0]} id="delete" look="spot"
            ><span {...stylex.attrs(btn, styles.red)}>Delete</span></QuizChoice
          ></span
        >
      </span>
    </div>
  </RuleQuiz>
  <RuleQuiz n={4} level={safe.levels[1]!}
    ><b>Add contact</b> has Name and Email fields. Tap where focus starts.
    <div slot="board" {...stylex.attrs(quiz.screen, quiz.dimmed)}>
      <span {...stylex.attrs(quiz.panel)}>
        <span {...stylex.attrs(styles.head)}
          ><span {...stylex.attrs(styles.title)}>Add contact</span><QuizChoice level={safe.levels[1]!} id="close" look="spot"
            ><span {...stylex.attrs(styles.close, quiz.close)}><Icon {...x} {...stylex.attrs(styles.closeIcon)} /></span></QuizChoice
          ></span
        >
        <QuizChoice level={safe.levels[1]!} id="name" look="spot"
          ><span {...stylex.attrs(styles.field)}
            ><span {...stylex.attrs(styles.label)}>Name</span><span {...stylex.attrs(styles.input, quiz.input, quiz.placeholder)}
              >Ada Lovelace</span
            ></span
          ></QuizChoice
        >
        <span {...stylex.attrs(styles.field)}
          ><span {...stylex.attrs(styles.label)}>Email</span><span {...stylex.attrs(styles.input, quiz.input, quiz.placeholder)}
            >ada@example.com</span
          ></span
        >
        <span {...stylex.attrs(styles.acts)}
          ><QuizChoice level={safe.levels[1]!} id="save" look="spot"><span {...stylex.attrs(btn)}>Save</span></QuizChoice></span
        >
      </span>
    </div>
  </RuleQuiz>

  <RuleLesson lesson={draft}>
    <Fragment slot="body">A click outside is often a slip. Once a form has input, shake the dialog on that click instead of closing it, and ask before <Kbd>Esc</Kbd> or × discards the draft. Click the dim area in both.</Fragment>
    <DialogDraftDemo slot="bad" />
    <DialogDraftDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={5} level={draft.levels[0]}
    >Three dialogs, and a click lands on the dim area by mistake. Pick the one that should shake and stay open.
    <div slot="board" {...stylex.attrs(quizKit.trio)}>
      <QuizChoice level={draft.levels[0]} id="news" caption="Nothing to fill in"
        ><span {...stylex.attrs(quiz.mini)}
          ><span {...stylex.attrs(quiz.miniPanel)}
            ><span {...stylex.attrs(quiz.miniHead)}
              ><span {...stylex.attrs(quiz.miniTitle)}>What's new</span><Icon {...x} {...stylex.attrs(quiz.miniX)} /></span
            ><span style="--w:92%" {...stylex.attrs(styles.ghost)}></span><span style="--w:64%" {...stylex.attrs(styles.ghost)}></span><span
              {...stylex.attrs(quiz.miniActs)}><span {...stylex.attrs(quiz.miniBtn)}>Got it</span></span
            ></span
          ><span {...stylex.attrs(quiz.click)}><span {...stylex.attrs(quiz.clickDot)}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={draft.levels[0]} id="issue" caption="Title typed in"
        ><span {...stylex.attrs(quiz.mini)}
          ><span {...stylex.attrs(quiz.miniPanel)}
            ><span {...stylex.attrs(quiz.miniHead)}
              ><span {...stylex.attrs(quiz.miniTitle)}>New issue</span><Icon {...x} {...stylex.attrs(quiz.miniX)} /></span
            ><span {...stylex.attrs(quiz.miniField)}>{DRAFT}</span><span {...stylex.attrs(quiz.miniActs)}
              ><span {...stylex.attrs(quiz.miniBtn)}>Create</span></span
            ></span
          ><span {...stylex.attrs(quiz.click)}><span {...stylex.attrs(quiz.clickDot)}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={draft.levels[0]} id="preview" caption="Image preview"
        ><span {...stylex.attrs(quiz.mini)}
          ><span {...stylex.attrs(quiz.miniPanel)}
            ><span {...stylex.attrs(quiz.miniHead)}
              ><span {...stylex.attrs(quiz.miniTitle)}>photo.jpg</span><Icon {...x} {...stylex.attrs(quiz.miniX)} /></span
            ><span {...stylex.attrs(quiz.miniFigure)}></span></span
          ><span {...stylex.attrs(quiz.click)}><span {...stylex.attrs(quiz.clickDot)}></span>click</span></span
        ></QuizChoice
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={scroll}>
    <Fragment slot="body">Stop the page under the dialog from scrolling, so it stays still. Keep the scrollbar's space so nothing shifts when the scrollbar hides. Open Share, then scroll.</Fragment>
    <DialogScrollDemo slot="bad" />
    <DialogScrollDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={6} level={scroll.levels[0]}
    ><b>Share</b> opens over a long article. Here are its layers, pulled apart. Tap the one to lock so the article stays still.
    <div slot="board" {...stylex.attrs(quiz.layers)}>
      <span {...stylex.attrs(quiz.layerCol)}
        ><span {...stylex.attrs(quiz.tilt)}
          ><QuizChoice level={scroll.levels[0]} id="body" look="spot"
            ><span {...stylex.attrs(quiz.slab)}
              >{[80, 92, 70].map((width) => <span style={`--w:${width}%`} {...stylex.attrs(styles.ghost)}></span>)}<span
                {...stylex.attrs(quiz.slabFigure)}></span
              >{[88, 60, 94, 76, 84, 52].map((width) => <span style={`--w:${width}%`} {...stylex.attrs(styles.ghost)}></span>)}<span
                {...stylex.attrs(quiz.thumb)}></span></span
            ></QuizChoice
          ></span
        ><span {...stylex.attrs(quiz.layerName)}>The page</span></span
      >
      <span {...stylex.attrs(quiz.layerCol)}
        ><span {...stylex.attrs(quiz.tilt)}
          ><QuizChoice level={scroll.levels[0]} id="scrim" look="spot"
            ><span {...stylex.attrs(quiz.slab, quiz.slabScrim)}></span></QuizChoice
          ></span
        ><span {...stylex.attrs(quiz.layerName)}>The dim layer</span></span
      >
      <span {...stylex.attrs(quiz.layerCol)}
        ><span {...stylex.attrs(quiz.tilt)}
          ><QuizChoice level={scroll.levels[0]} id="panel" look="spot"
            ><span {...stylex.attrs(quiz.slab, quiz.slabPanel)}
              ><span {...stylex.attrs(quiz.miniHead)}
                ><span {...stylex.attrs(quiz.miniTitle)}>Share</span><Icon {...x} {...stylex.attrs(quiz.miniX)} /></span
              ><span {...stylex.attrs(quiz.miniField)}>itsfaqih.dev/p/42</span></span
            ></QuizChoice
          ></span
        ><span {...stylex.attrs(quiz.layerName)}>The dialog panel</span></span
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={name}>
    <Fragment slot="body">Tell a screen reader that a dialog opened and what it's called. Mark it as a modal dialog, name it by its title and describe it by its text.</Fragment>
    <DialogNameDemo slot="bad" />
    <DialogNameDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={7} level={name.levels[0]}
    >A screen reader user presses Delete and <b>Delete Moonbase?</b> opens. Pick what they should hear.
    <div slot="board" {...stylex.attrs(quizKit.stack)}>
      {
        (
          [
            ["plain", "A plain box", ["Cancel, button"]],
            ["role", "Marked as a dialog", ["dialog", "Cancel, button"]],
            ["named", "Named and described", ["Delete Moonbase?, dialog", "Its 214 files go too. This can't be undone.", "Cancel, button"]],
          ] as const
        ).map(([id, caption, lines]) => (
          <QuizChoice level={name.levels[0]} id={id} caption={caption}
            ><span {...stylex.attrs(quiz.transcript)}
              >{
                lines.map((line) => (
                  <span {...stylex.attrs(styles.speech)}
                    ><Icon name="SpeakerHigh" size="1em" weight="bold" aria-hidden="true" {...stylex.attrs(styles.speaker)} />{line}</span
                  >
                ))
              }</span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>
</RuleLanding>

<script>
  import "./dialog-design.client";
</script>
