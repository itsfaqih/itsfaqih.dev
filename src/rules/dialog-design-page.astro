---
import Icon from "../components/icon.astro";
import DialogConfirmDemo from "./dialog-confirm-demo.astro";
import { DRAFT, LESSONS, TLDR } from "./dialog-design";
import { quiz, styles } from "./dialog-design.css";
import { quizKit } from "./rule-landing.css";
import DialogDraftDemo from "./dialog-draft-demo.astro";
import DialogEscapeDemo from "./dialog-escape-demo.astro";
import DialogFocusDemo from "./dialog-focus-demo.astro";
import DialogNameDemo from "./dialog-name-demo.astro";
import DialogScrollDemo from "./dialog-scroll-demo.astro";
import Kbd from "./kbd.astro";
import LessonText from "./lesson-text.astro";
import RuleLanding from "./rule-landing.astro";
import RuleLesson from "./rule-lesson.astro";
import QuizChoice from "./quiz-choice.astro";
import RuleQuiz from "./rule-quiz.astro";

const [focus, escape, safe, draft, scroll, name] = LESSONS;
const btn = [styles.btn, quiz.key];
const x = { name: "X", size: "1em", weight: "bold", "aria-hidden": "true" } as const;
---

<RuleLanding id="dialog-design" learn="Hold focus, let go cleanly" tldr={TLDR} take="build dialogs the same way">
  <Fragment slot="lead">Trap Tab inside the dialog, lock the page behind it, and name it for screen readers.</Fragment>
  <Fragment slot="intro">Give a dialog a way through and a way out, since it takes over the screen.</Fragment>

  <RuleLesson lesson={focus}>
    <Fragment slot="body">Move focus into the dialog when it opens. Let <Kbd>Tab</Kbd> cycle its controls and never reach the inert page behind. On close, return focus to the button that opened it. Press Tab in both.</Fragment>
    <DialogFocusDemo slot="bad" />
    <DialogFocusDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={1} level={focus.levels[0]}
    >You opened <b>Edit profile</b> from its button halfway down a settings page, then pressed Save. Tap where focus goes.
    <div slot="board" class={quiz.screen}>
      <span class:list={[styles.page, quiz.page]}>
        <QuizChoice level={focus.levels[0]} id="body" look="spot"
          ><span class={styles.spread}
            ><span class={styles.logo}></span><span class={quiz.nav}
              >{Array.from({ length: 12 }, () => <span class={quiz.navLink}></span>)}</span
            ></span
          ></QuizChoice
        >
        <b class={styles.strong}>Settings</b>
        <span style="--w:64%" class={styles.ghost}></span>
        <span class:list={[styles.card, styles.spread, quiz.wrap]}
          ><span class={styles.project}
            ><b class={styles.strong}>Profile</b><small class={styles.meta}>Ada Lovelace</small></span
          ><QuizChoice level={focus.levels[0]} id="trigger" look="spot"
            ><span class:list={[btn, styles.soft, quiz.softInCard]}>Edit profile</span></QuizChoice
          ></span
        >
        <span class:list={[styles.card, styles.spread, quiz.wrap]}
          ><span class={styles.project}
            ><b class={styles.strong}>Password</b><small class={styles.meta}>changed 3 months ago</small></span
          ><QuizChoice level={focus.levels[0]} id="next" look="spot"
            ><span class:list={[btn, styles.soft, quiz.softInCard]}>Change password</span></QuizChoice
          ></span
        >
        <span style="--w:52%" class={styles.ghost}></span>
        <span style="--w:40%" class={styles.ghost}></span>
      </span>
    </div>
  </RuleQuiz>

  <RuleLesson lesson={escape}>
    <Fragment slot="body">Close every dialog on <Kbd>Esc</Kbd>, every time, since keyboard users leave that way. Let a click outside close an info dialog too, since closing it loses nothing.</Fragment>
    <DialogEscapeDemo slot="bad" />
    <DialogEscapeDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={2} level={escape.levels[0]}
    >Three dialogs, and a click lands on the dim area around each. Pick the one that click should close.
    <div slot="board" class={quizKit.trio}>
      <QuizChoice level={escape.levels[0]} id="issue" caption="Title typed in"
        ><span class={quiz.mini}
          ><span class={quiz.miniPanel}
            ><span class={quiz.miniHead}
              ><span class={quiz.miniTitle}>New issue</span><Icon {...x} class={quiz.miniX} /></span
            ><span class={quiz.miniField}>{DRAFT}</span><span class={quiz.miniActs}
              ><span class={quiz.miniBtn}>Create</span></span
            ></span
          ><span class={quiz.click}><span class={quiz.clickDot}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={escape.levels[0]} id="news" caption="Nothing to fill in"
        ><span class={quiz.mini}
          ><span class={quiz.miniPanel}
            ><span class={quiz.miniHead}
              ><span class={quiz.miniTitle}>What's new</span><Icon {...x} class={quiz.miniX} /></span
            ><span style="--w:92%" class={styles.ghost}></span><span style="--w:64%" class={styles.ghost}></span><span
              class={quiz.miniActs}><span class={quiz.miniBtn}>Got it</span></span
            ></span
          ><span class={quiz.click}><span class={quiz.clickDot}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={escape.levels[0]} id="profile" caption="Nothing changed yet"
        ><span class={quiz.mini}
          ><span class={quiz.miniPanel}
            ><span class={quiz.miniHead}><span class={quiz.miniTitle}>Edit profile</span></span><span
              class={quiz.miniField}>Ada Lovelace</span
            ><span class={quiz.miniActs}
              ><span class:list={[quiz.miniBtn, quiz.miniPlain]}>Cancel</span><span class={quiz.miniBtn}>Save</span></span
            ></span
          ><span class={quiz.click}><span class={quiz.clickDot}></span>click</span></span
        ></QuizChoice
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={safe}>
    <Fragment slot="body">Focus a form's first field so people can type at once. Focus Cancel on a confirm that destroys something, so a stray <Kbd>Enter</Kbd> backs out. Open both and press Enter.</Fragment>
    <LessonText slot="extra" tip>Focus the destructive button only where speed matters more and the action can be undone.</LessonText>
    <DialogConfirmDemo slot="bad" />
    <DialogConfirmDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={3} level={safe.levels[0]}
    ><b>Delete Moonbase?</b> removes 214 files for good. Tap where focus starts.
    <div slot="board" class:list={[quiz.screen, quiz.tall]}>
      <span class:list={[quiz.layer, styles.page, quiz.page]}>
        <span class={styles.spread}><span class={styles.logo}></span><span style="--w:30%" class={styles.ghost}></span></span>
        <span class:list={[styles.card, styles.spread, quiz.wrap]}
          ><span class={styles.project}
            ><b class={styles.strong}>Moonbase</b><small class={styles.meta}>214 files · edited 2h ago</small></span
          ><QuizChoice level={safe.levels[0]} id="trigger" look="spot"
            ><span class:list={[btn, styles.red, styles.redTint]}>Delete project</span></QuizChoice
          ></span
        >
        <span style="--w:62%" class={styles.ghost}></span>
      </span>
      <span aria-hidden="true" class:list={[quiz.layer, quiz.scrim]}></span>
      <span class:list={[quiz.layer, quiz.panel, quiz.low]}>
        <span class={styles.head}><span class={styles.title}>Delete Moonbase?</span></span>
        <span class={styles.body}>Its 214 files go too. This can't be undone.</span>
        <span class={styles.acts}
          ><QuizChoice level={safe.levels[0]} id="cancel" look="spot"
            ><span class:list={[btn, styles.plain, quiz.plain]}>Cancel</span></QuizChoice
          ><QuizChoice level={safe.levels[0]} id="delete" look="spot"
            ><span class:list={[btn, styles.red]}>Delete</span></QuizChoice
          ></span
        >
      </span>
    </div>
  </RuleQuiz>
  <RuleQuiz n={4} level={safe.levels[1]!}
    ><b>Add contact</b> has Name and Email fields. Tap where focus starts.
    <div slot="board" class:list={[quiz.screen, quiz.dimmed]}>
      <span class={quiz.panel}>
        <span class={styles.head}
          ><span class={styles.title}>Add contact</span><QuizChoice level={safe.levels[1]!} id="close" look="spot"
            ><span class:list={[styles.close, quiz.close]}><Icon {...x} class={styles.closeIcon} /></span></QuizChoice
          ></span
        >
        <QuizChoice level={safe.levels[1]!} id="name" look="spot"
          ><span class={styles.field}
            ><span class={styles.label}>Name</span><span class:list={[styles.input, quiz.input, quiz.placeholder]}
              >Ada Lovelace</span
            ></span
          ></QuizChoice
        >
        <span class={styles.field}
          ><span class={styles.label}>Email</span><span class:list={[styles.input, quiz.input, quiz.placeholder]}
            >ada@example.com</span
          ></span
        >
        <span class={styles.acts}
          ><QuizChoice level={safe.levels[1]!} id="save" look="spot"><span class:list={[btn]}>Save</span></QuizChoice></span
        >
      </span>
    </div>
  </RuleQuiz>

  <RuleLesson lesson={draft}>
    <Fragment slot="body">A click outside is often a slip. Once a form has input, shake the dialog on that click instead of closing it, and ask before <Kbd>Esc</Kbd> or × discards the draft. Click the dim area in both.</Fragment>
    <DialogDraftDemo slot="bad" />
    <DialogDraftDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={5} level={draft.levels[0]}
    >Three dialogs, and a click lands on the dim area by mistake. Pick the one that should shake and stay open.
    <div slot="board" class={quizKit.trio}>
      <QuizChoice level={draft.levels[0]} id="news" caption="Nothing to fill in"
        ><span class={quiz.mini}
          ><span class={quiz.miniPanel}
            ><span class={quiz.miniHead}
              ><span class={quiz.miniTitle}>What's new</span><Icon {...x} class={quiz.miniX} /></span
            ><span style="--w:92%" class={styles.ghost}></span><span style="--w:64%" class={styles.ghost}></span><span
              class={quiz.miniActs}><span class={quiz.miniBtn}>Got it</span></span
            ></span
          ><span class={quiz.click}><span class={quiz.clickDot}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={draft.levels[0]} id="issue" caption="Title typed in"
        ><span class={quiz.mini}
          ><span class={quiz.miniPanel}
            ><span class={quiz.miniHead}
              ><span class={quiz.miniTitle}>New issue</span><Icon {...x} class={quiz.miniX} /></span
            ><span class={quiz.miniField}>{DRAFT}</span><span class={quiz.miniActs}
              ><span class={quiz.miniBtn}>Create</span></span
            ></span
          ><span class={quiz.click}><span class={quiz.clickDot}></span>click</span></span
        ></QuizChoice
      >
      <QuizChoice level={draft.levels[0]} id="preview" caption="Image preview"
        ><span class={quiz.mini}
          ><span class={quiz.miniPanel}
            ><span class={quiz.miniHead}
              ><span class={quiz.miniTitle}>photo.jpg</span><Icon {...x} class={quiz.miniX} /></span
            ><span class={quiz.miniFigure}></span></span
          ><span class={quiz.click}><span class={quiz.clickDot}></span>click</span></span
        ></QuizChoice
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={scroll}>
    <Fragment slot="body">Stop the page under the dialog from scrolling, so it stays still. Keep the scrollbar's space so nothing shifts when the scrollbar hides. Open Share, then scroll.</Fragment>
    <DialogScrollDemo slot="bad" />
    <DialogScrollDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={6} level={scroll.levels[0]}
    ><b>Share</b> opens over a long article. Here are its layers, pulled apart. Tap the one to lock so the article stays still.
    <div slot="board" class={quiz.layers}>
      <span class={quiz.layerCol}
        ><span class={quiz.tilt}
          ><QuizChoice level={scroll.levels[0]} id="body" look="spot"
            ><span class={quiz.slab}
              >{[80, 92, 70].map((width) => <span style={`--w:${width}%`} class={styles.ghost}></span>)}<span
                class={quiz.slabFigure}></span
              >{[88, 60, 94, 76, 84, 52].map((width) => <span style={`--w:${width}%`} class={styles.ghost}></span>)}<span
                class={quiz.thumb}></span></span
            ></QuizChoice
          ></span
        ><span class={quiz.layerName}>The page</span></span
      >
      <span class={quiz.layerCol}
        ><span class={quiz.tilt}
          ><QuizChoice level={scroll.levels[0]} id="scrim" look="spot"
            ><span class:list={[quiz.slab, quiz.slabScrim]}></span></QuizChoice
          ></span
        ><span class={quiz.layerName}>The dim layer</span></span
      >
      <span class={quiz.layerCol}
        ><span class={quiz.tilt}
          ><QuizChoice level={scroll.levels[0]} id="panel" look="spot"
            ><span class:list={[quiz.slab, quiz.slabPanel]}
              ><span class={quiz.miniHead}
                ><span class={quiz.miniTitle}>Share</span><Icon {...x} class={quiz.miniX} /></span
              ><span class={quiz.miniField}>itsfaqih.dev/p/42</span></span
            ></QuizChoice
          ></span
        ><span class={quiz.layerName}>The dialog panel</span></span
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={name}>
    <Fragment slot="body">Tell a screen reader that a dialog opened and what it's called. Mark it as a modal dialog, name it by its title and describe it by its text.</Fragment>
    <DialogNameDemo slot="bad" />
    <DialogNameDemo slot="good" sealed />
  </RuleLesson>
  <RuleQuiz n={7} level={name.levels[0]}
    >A screen reader user presses Delete and <b>Delete Moonbase?</b> opens. Pick what they should hear.
    <div slot="board" class={quizKit.stack}>
      {
        (
          [
            ["plain", "A plain box", ["Cancel, button"]],
            ["role", "Marked as a dialog", ["dialog", "Cancel, button"]],
            ["named", "Named and described", ["Delete Moonbase?, dialog", "Its 214 files go too. This can't be undone.", "Cancel, button"]],
          ] as const
        ).map(([id, caption, lines]) => (
          <QuizChoice level={name.levels[0]} id={id} caption={caption}
            ><span class={quiz.transcript}
              >{
                lines.map((line) => (
                  <span class={styles.speech}
                    ><Icon name="SpeakerHigh" size="1em" weight="bold" aria-hidden="true" class={styles.speaker} />{line}</span
                  >
                ))
              }</span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>
</RuleLanding>

<script>
  import "./dialog-design.client";
</script>
