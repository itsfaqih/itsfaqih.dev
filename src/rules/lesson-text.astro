---
import { type ClassValue } from "../cx";
import { text } from "./rule-landing.css";

type Props = {
  /** A side note under the lesson copy. */
  tip?: boolean;
  style?: ClassValue;
};

const { tip = false, style } = Astro.props;
---

<p class:list={[text.lesson, tip && text.tip, style]}><slot /></p>
