---
import type { Level } from "./lesson";
import { quizKit } from "./rule-landing.css";
import { quizView } from "./rule-landing.view";

type Props = {
  level: Level;
  id: string;
  look?: "card" | "spot";
  caption?: string;
};

const { level, id, look = "card", caption } = Astro.props;
const choice = "choices" in level ? level.choices.find((candidate) => candidate.id === id) : undefined;
if (!choice) throw new Error(`${level.name} has no choice "${id}"`);
// A button holds phrasing content only, so the slot is drawn from spans.
---

<button
  type="button"
  class={quizView.choice(look, { missed: false, cleared: false, seated: false })}
  aria-label={choice.label}
  data-part="slot"
  data-slot={choice.id}
  data-note={choice.note}
  data-look={look}
  ><span class={quizKit.choiceBody}><slot /></span>{
    caption && <span class={quizKit.caption}>{caption}</span>
  }</button
>
