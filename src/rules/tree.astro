---
import type { TreeRow } from "./lesson";
import { tree } from "./rule-landing.css";

type Props = { rows: TreeRow[] };

const { rows } = Astro.props;
---

<ul class:list={[tree.list, tree.inPane]}>
  {
    rows.map((row) => (
      <li
        data-k={row.k ?? row.text}
        data-moved={row.moved ? "true" : undefined}
        class:list={[tree.row, row.kind && tree[row.kind]]}
        style={`--d:${row.depth}`}
        ><span class:list={[row.moved && tree.moved]}>{row.text}</span>{
          row.tag && <span class={tree.calls}>{row.tag}</span>
        }</li
      >
    ))
  }
</ul>
