---
import * as stylex from "@stylexjs/stylex";
import Icon from "../components/icon.astro";
import DialogBox from "./dialog-box.astro";
import { styles } from "./dialog-design.styles";
import DialogField from "./dialog-field.astro";
import DialogKey from "./dialog-key.astro";
import DialogWindow from "./dialog-window.astro";
import { host } from "./rule-landing.styles";

type Props = { sealed?: boolean };

const { sealed = false } = Astro.props;
// The template holds the speaker line, which dialog-design.client.ts fills with what a screen
// reader would say.
---

<dialog-name {...stylex.attrs(host.contents)} data-sealed={sealed ? "" : undefined}>
  <DialogWindow>
    <div slot="page" {...stylex.attrs(styles.page)} data-part="page">
      <div {...stylex.attrs(styles.spread)}><span {...stylex.attrs(styles.logo)}></span><span style="--w:34%" {...stylex.attrs(styles.ghost)}></span></div>
      <div {...stylex.attrs(styles.card, styles.spreadInCard)}><span {...stylex.attrs(styles.project)}><b {...stylex.attrs(styles.strong)}>report.pdf</b><small {...stylex.attrs(styles.meta)}>2.4 MB · shared</small></span><button data-hint="true" type="button" data-stop="trigger" {...stylex.attrs(styles.stop, styles.btn, styles.soft, styles.softInCard)}>Rename</button></div>
      <span style="--w:58%" {...stylex.attrs(styles.ghost)}></span>
    </div>
    <DialogBox id={`name-${sealed ? "good" : "bad"}-`} bare={!sealed} title="Rename file" body="Pick a name your team will find." part="dialog">
      <DialogField name="name" label="Name" value="report.pdf" />
      <div {...stylex.attrs(styles.acts)}><button type="button" data-stop="cancel" {...stylex.attrs(styles.stop, styles.btn, styles.plain)}>Cancel</button><button type="button" data-stop="save" {...stylex.attrs(styles.stop, styles.btn)}>Save</button></div>
    </DialogBox>
    <DialogKey slot="keys" part="tab">Tab</DialogKey>
    <Fragment slot="read">Open Rename to hear it</Fragment>
  </DialogWindow>
  <template data-part="speech"><span {...stylex.attrs(styles.speech)}><Icon name="SpeakerHigh" size="1em" weight="bold" aria-hidden="true" {...stylex.attrs(styles.speaker)} /></span></template>
</dialog-name>
