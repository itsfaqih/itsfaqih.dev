---
import * as stylex from "@stylexjs/stylex";
import { arcade } from "../components/arcade";
import { KINDS, paint, styles } from "./null-vs-undefined.styles";

type Props = { text: string; tone: "plain" | "wrap" };

const { text, tone } = Astro.props;
// A slot's label is a blank for screen readers to read; the rest is code.
---

{
  tone === "wrap" ? (
    <Fragment><span {...stylex.attrs(arcade.srOnly)}>{text}</span><span aria-hidden="true" {...stylex.attrs(styles.gap)} /></Fragment>
  ) : (
    <code {...stylex.attrs(styles.boardCode)}>{paint(text, KINDS).map((p) => (p.class ? <span class={p.class}>{p.text}</span> : p.text))}</code>
  )
}
