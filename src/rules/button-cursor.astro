---
import { quiz } from "./button-design.css";

// A drawn pointer for a quiz card, since a card can't show a real cursor until it's hovered. The
// hand says press; the no-entry sign says the button can't act.
type Props = { kind: "hand" | "forbid" };

const { kind } = Astro.props;
---

<svg class={quiz.cursor} viewBox="0 0 24 24" aria-hidden="true"
  >{
    kind === "hand" ? (
      <path
        d="M9 3.5a1.5 1.5 0 0 1 3 0V10h.5V8.5a1.5 1.5 0 0 1 3 0V11h.3V9.8a1.5 1.5 0 0 1 3 0V15c0 3.6-2.6 6.5-6 6.5h-1.2c-2 0-3.4-.9-4.6-2.6L4 15.2a1.5 1.5 0 0 1 2.4-1.8L9 15.8Z"
        fill="#fff"
        stroke="#111"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    ) : (
      <>
        <circle cx="12" cy="12" r="9" fill="#fff" stroke="#111" stroke-width="2.5" />
        <path d="M5.8 18.2 18.2 5.8" stroke="#111" stroke-width="2.5" />
      </>
    )
  }</svg
>
