---
import DataLoadingRow from "./data-loading-row.astro";
import type { Level } from "./lesson";
import RuleQuiz from "./rule-quiz.astro";

type Props = { n: number; level: Level };

const { n, level } = Astro.props;
// The default slot is the prompt. Each timed row leads with its time.
---

<RuleQuiz n={n} level={level} board="timeline" marks={{ text: DataLoadingRow }}><slot /></RuleQuiz>
