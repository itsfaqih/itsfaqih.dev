---
import { HINT } from "./hints";
import { FIXES, fateSays, QUERY, searches, shownSearch } from "./data-loading";
import { styles } from "./data-loading.css";
import { view } from "./data-loading.view";

type Props = {
  /** Wait for a pause in typing before each request, and cancel the one in flight. */
  debounce?: boolean;
};

const { debounce = false } = Astro.props;
// The still state is the end of the run: the word typed, every request's fate, the results shown.
const fix = debounce ? FIXES.both : FIXES.none;
const sent = searches(fix);
const shown = shownSearch(fix)!;
const stale = shown.q !== QUERY;
---

<data-loading-search class={styles.view} data-debounce={debounce ? "" : undefined}
  ><div class={styles.card}
    ><div class={styles.head}
      ><span>Search</span><span class={styles.status} data-part="count">{sent.length}<!-- --> sent</span
      ></div
    ><div class={styles.box}
      ><i aria-hidden="true" class={styles.boxGlass}></i><span data-part="typed">{QUERY}</span><i
        aria-hidden="true"
        class={styles.caret}
        data-part="caret"></i
      ></div
    ><div class={view.results(stale)} aria-live="polite" data-part="results"
      ><span>{shown.matches.join(", ")}</span><span class={view.resultsFor(stale)}>for {shown.q}</span></div
    ><ol class={styles.log} data-part="log"
      >{
        sent.map(({ q, fate }) => (
          <li class={styles.logRow}
            ><span class={view.logQuery(fate)}>GET ?q={q}</span><span
              class={view.fate(fate, q !== QUERY)}>{fateSays(fate, q)}</span
            ></li
          >
        ))
      }</ol
    ></div
  ><div class={styles.ctl}
    ><span class={styles.note}>Types {QUERY}, with a pause after la</span><button
      data-hint={HINT.tap}
      type="button"
      class={view.ctlButton}
      data-part="type">Type {QUERY}</button
    ></div
  ></data-loading-search
>

<script>
  import "./data-loading-search.client";
</script>
