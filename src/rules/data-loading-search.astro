---
import { HINT } from "./hints";
import { QUERY } from "./data-loading";
import { styles } from "./data-loading.css";
import { view } from "./data-loading.view";

type Props = {
  /** Wait for a pause in typing before each request, and cancel the one in flight. */
  debounce?: boolean;
};

const { debounce = false } = Astro.props;
---

<data-loading-search class={styles.view} data-debounce={debounce ? "" : undefined}
  ><div class={styles.card}
    ><div class={styles.head}
      ><span>Search</span><span class={styles.status} data-part="count">0<!-- --> sent</span
      ></div
    ><div class={styles.box}
      ><i aria-hidden="true" class={styles.boxGlass}></i><span data-part="typed"></span><i
        aria-hidden="true"
        class={styles.caret}
        data-part="caret"></i
      ></div
    ><div class={view.results(false)} aria-live="polite" data-part="results"
      ><span class={styles.status}>No results yet</span></div
    ><ol class={styles.log} data-part="log"></ol
    ></div
  ><div class={styles.ctl}
    ><span class={styles.note}>Types {QUERY}, with a pause after la</span><button
      data-hint={HINT.tap}
      type="button"
      class={view.ctlButton}
      data-part="type">Type {QUERY}</button
    ></div
  ></data-loading-search
>

<script>
  import "./data-loading-search.client";
</script>
