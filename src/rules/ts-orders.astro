---
import { digits, HOUR, ordersLines, ordersOf, type Way } from "./handling-timestamps";
import { styles } from "./handling-timestamps.css";
import TsWire from "./ts-wire.astro";

type Props = { way: Way };

const { way } = Astro.props;
const rows = ordersOf(way);
const first = rows[0]?.at ?? 0;
const gap = ((rows[rows.length - 1]?.at ?? 0) - first) / HOUR;
---

<div class={styles.view}>
  <TsWire lines={ordersLines(way)} /><table class={styles.table}
    ><thead
      ><tr
        ><th scope="col" class={styles.th}>id</th><th scope="col" class={styles.th}
          >by</th
        ><th scope="col" class={styles.th}>created_at</th></tr
      ></thead
    ><tbody
      >{
        rows.map((row) => (
          <tr
            ><td class={styles.td}>{row.id}</td><td class={styles.td}>{row.by.who}</td><td
              class:list={[styles.td, styles.at]}>{digits(row.at).replace("T", " ")}</td
            ></tr
          >
        ))
      }</tbody
    ></table
  ><p class={styles.sum}>{gap ? `One second, stored ${gap} h apart.` : "One second, one value."}</p>
</div>
