---
import { HINT } from "./hints";
import { arcade } from "../components/arcade.css";
import { REMINDER, reminderLines, reminderOf, type Way } from "./handling-timestamps";
import { styles } from "./handling-timestamps.css";
import { host } from "./rule-landing.css";
import TsReaders from "./ts-readers.astro";
import TsWire from "./ts-wire.astro";

type Props = { way: Way };

const { way } = Astro.props;
const { wall, meant, stored, readings } = reminderOf(way, REMINDER.date, REMINDER.time);
const id = `ts-${way}`;
---

<ts-reminder class={host.contents} data-way={way}>
  <div class={styles.view}>
    <div class={styles.form}>
      <span class={styles.formHead}>New reminder · Rina, Jakarta</span><label
        for={`${id}-date`}
        class={arcade.srOnly}>Date</label
      ><input
        id={`${id}-date`}
        type="date"
        required
        class={styles.input}
        value={REMINDER.date}
        data-part="date"
      /><label for={`${id}-time`} class={arcade.srOnly}>Time</label><input
        data-hint={HINT.edit}
        id={`${id}-time`}
        type="time"
        required
        class={styles.input}
        value={REMINDER.time}
        data-part="time"
      />
    </div>
    <TsWire lines={reminderLines(way, wall, meant)} />
    <TsReaders readings={readings} utc={stored} />
  </div>
</ts-reminder>

<script>
  import "./ts-reminder.client";
</script>
