---
import Icon from "../components/icon.astro";
import { styles } from "./button-design.css";
import Ruler from "./button-ruler.astro";

type Props = { careful?: boolean };

const { careful = false } = Astro.props;
const key = [styles.key, styles.sm, styles.live];
const pad = [styles.pads, !careful && styles.even];
const near = careful ? 12 : 16;
---

<div class:list={[styles.stage, styles.icons]}>
  <button type="button" class:list={[key, styles.tint, styles.lead, pad]}
    ><Icon
      name="Plus"
      size="1em"
      weight="bold"
      aria-hidden="true"
      class={styles.icon}
    />New project<Ruler pads={[near, 16]} /></button
  >
  <button type="button" class:list={[key, styles.trail, pad]}
    >Continue<Icon
      name="ArrowRight"
      size="1em"
      weight="bold"
      aria-hidden="true"
      class={styles.icon}
    /><Ruler pads={[16, near]} /></button
  >
</div>
