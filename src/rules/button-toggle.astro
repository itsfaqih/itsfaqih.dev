---
import { button } from "../components/button.css";
import { buttonVariant } from "../components/button";
import { styles } from "./button-design.css";
import { view } from "./button-design.view";
import { host } from "./rule-landing.css";

type Props = {
  label: string;
  /** Read by the demo's styles as `[data-toggle=name][aria-pressed=true]`. */
  name: string;
};

const { label, name } = Astro.props;
---

<button-toggle class={host.contents}
  ><button
    data-hint="true"
    type="button"
    class:list={[button.base, buttonVariant["primary-neutral"], button.sm, styles.toggle]}
    data-toggle={name}
    aria-pressed="false"
    ><span class={view.dot(false)} aria-hidden="true"></span>{label}</button
  ></button-toggle
>

<script>
  import "./button-toggle.client";
</script>
