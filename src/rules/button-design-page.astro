---
import * as stylex from "@stylexjs/stylex";
import Icon from "../components/icon.astro";
import { LESSONS, TLDR } from "./button-design";
import { quiz, styles } from "./button-design.styles";
import { quizKit } from "./rule-landing.styles";
import ButtonDelete from "./button-delete.astro";
import ButtonHierarchy from "./button-hierarchy.astro";
import ButtonIcons from "./button-icons.astro";
import ButtonPublish from "./button-publish.astro";
import ButtonStates from "./button-states.astro";
import ButtonStill from "./button-still.astro";
import ButtonToggle from "./button-toggle.astro";
import Kbd from "./kbd.astro";
import RuleLanding from "./rule-landing.astro";
import RuleLesson from "./rule-lesson.astro";
import QuizChoice from "./quiz-choice.astro";
import RuleQuiz from "./rule-quiz.astro";
import Ruler from "./button-ruler.astro";

const [states, disabled, still, hierarchy, guard, icons] = LESSONS;
// The quiz boards draw buttons as pictures, so they keep still and take no focus of their own.
const key = [styles.key, styles.sm, styles.flat];
---

<RuleLanding
  id="button-design"
  learn="Answer every press"
  tldr={TLDR}
  take="build buttons the same way"
>
  <Fragment slot="lead">Style every state, say why it's off, and guard anything destructive.</Fragment>
  <Fragment slot="intro">Give each state and refusal a visible change, so no press feels lost.</Fragment>

  <RuleLesson lesson={states}>
    <Fragment slot="body"
      >Give hover, press and focus a look. If nothing changes, a click feels like it missed and a keyboard user can't see where they are. Hover both, press both, then <Kbd>Tab</Kbd> to them.</Fragment
    >
    <ButtonStates slot="bad" />
    <ButtonStates slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={1} level={states.levels[0]}
    >Mia uses only the keyboard. She presses <Kbd>Tab</Kbd> to reach <b>Save</b>. Pick the Save that shows her where she is.
    <div slot="board" {...stylex.attrs(quizKit.trio)}>
      <QuizChoice level={states.levels[0]} id="hover" caption="Changes on hover"
        ><span {...stylex.attrs(quiz.mock)}><span {...stylex.attrs(key, styles.hover)}>Save</span></span></QuizChoice
      >
      <QuizChoice level={states.levels[0]} id="press" caption="Changes on press"
        ><span {...stylex.attrs(quiz.mock)}><span {...stylex.attrs(key, styles.press)}>Save</span></span></QuizChoice
      >
      <QuizChoice level={states.levels[0]} id="focus" caption="Changes on focus"
        ><span {...stylex.attrs(quiz.mock)}><span {...stylex.attrs(key, styles.focus)}>Save</span></span></QuizChoice
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={disabled}>
    <Fragment slot="body"
      >A disabled button that only fades leaves people guessing, most of all when the form looks done. Show the no-entry cursor, keep the label readable, and put the reason in a tooltip. Find out why Publish is off in both, then fix it.</Fragment
    >
    <ButtonPublish slot="bad" />
    <ButtonPublish slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={2} level={disabled.levels[0]}
    >Publish stays off because an older post already uses this URL. Nothing else on screen says so. Pick how Publish looks when someone hovers it.
    <div slot="board" {...stylex.attrs(quizKit.trio)}>
      <QuizChoice level={disabled.levels[0]} id="fade" caption="Faded to 40%"
        ><span {...stylex.attrs(quiz.mock, quiz.tipRoom)}><span {...stylex.attrs(key, styles.faded)}>Publish</span></span></QuizChoice
      >
      <QuizChoice level={disabled.levels[0]} id="hide" caption="Hidden until it works"
        ><span {...stylex.attrs(quiz.mock, quiz.tipRoom)}><span {...stylex.attrs(quiz.gap)}></span></span></QuizChoice
      >
      <QuizChoice level={disabled.levels[0]} id="say" caption="Readable, says why"
        ><span {...stylex.attrs(quiz.mock, quiz.tipRoom)}
          ><span {...stylex.attrs(styles.tip)}
            ><span {...stylex.attrs(key, styles.off)}>Publish</span><span {...stylex.attrs(styles.tooltip, styles.tooltipOpen)}
              >That URL is taken</span
            ></span
          ></span
        ></QuizChoice
      >
    </div>
  </RuleQuiz>

  <RuleLesson lesson={still}>
    <Fragment slot="body"
      >A disabled button that lights up on hover says yes while its cursor says no, so people click and nothing happens. Keep its colour and its drop still on hover and press, and let the tooltip do the talking. Hover Back in both.</Fragment
    >
    <ButtonStill slot="bad" />
    <ButtonStill slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={3} level={still.levels[0]}
    >A pager sits on page 1 of 5, so <b>Previous</b> is disabled. Tap the control that should light up on hover.
    <div slot="board" {...stylex.attrs(quiz.screen)}>
      <span {...stylex.attrs(styles.small)}>Page 1 of 5</span>
      <span {...stylex.attrs(quiz.bar)}>
        <QuizChoice level={still.levels[0]} id="prev" look="spot"
          ><span {...stylex.attrs(key, quiz.pageKey, styles.off)}>Previous</span></QuizChoice
        >
        <QuizChoice level={still.levels[0]} id="current" look="spot"
          ><span {...stylex.attrs(key, quiz.pageKey, styles.tint)}>1</span></QuizChoice
        >
        <span {...stylex.attrs(key, quiz.pageKey, styles.text)}>2</span>
        <span {...stylex.attrs(key, quiz.pageKey, styles.text)}>3</span>
        <QuizChoice level={still.levels[0]} id="next" look="spot"
          ><span {...stylex.attrs(key, quiz.pageKey, styles.plain)}>Next</span></QuizChoice
        >
      </span>
    </div>
  </RuleQuiz>

  <RuleLesson lesson={hierarchy}>
    <Fragment slot="body"
      >Visual weight shows people the next step. Fill the main action in the brand colour, tint the supporting one, and leave Cancel as text. Keep red for destructive actions.</Fragment
    >
    <ButtonToggle slot="extra" label="Squint" name="squint" />
    <ButtonHierarchy slot="bad" />
    <ButtonHierarchy slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={4} level={hierarchy.levels[0]}
    >A cart has three actions. <b>Continue shopping</b> is text and <b>Edit cart</b> is tinted. Pick the footer where <b>Checkout</b> reads as the next step.
    <div slot="board" {...stylex.attrs(quizKit.stack)}>
      {
        (
          [
            ["tint", "Checkout tinted", styles.tint],
            ["red", "Checkout filled red", styles.red],
            ["brand", "Checkout filled, brand colour", null],
          ] as const
        ).map(([id, caption, look]) => (
          <QuizChoice level={hierarchy.levels[0]} id={id} caption={caption}
            ><span {...stylex.attrs(quiz.mock, quiz.end)}
              ><span {...stylex.attrs(key, styles.text)}>Continue shopping</span><span {...stylex.attrs(key, styles.tint)}
                >Edit cart</span
              ><span {...stylex.attrs(key, look)}>Checkout</span></span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={guard}>
    <Fragment slot="body"
      >Never let one stray click delete anything. Confirm with a red button that names what goes, ask people to hold the button down, or delete at once and offer Undo. Try all three.</Fragment
    >
    <ButtonDelete slot="bad" />
    <ButtonDelete slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={5} level={guard.levels[0]}
    >A project page has three actions. Tap the one a stray click would make you regret, so it asks first.
    <div slot="board" {...stylex.attrs(quiz.screen)}>
      <span {...stylex.attrs(styles.cardTitle)}>Atlas</span>
      <span {...stylex.attrs(styles.cardSub)}>214 files, edited 2 hours ago</span>
      <span {...stylex.attrs(quiz.bar)}>
        <QuizChoice level={guard.levels[0]} id="rename" look="spot"
          ><span {...stylex.attrs(key, styles.plain)}>Rename</span></QuizChoice
        >
        <QuizChoice level={guard.levels[0]} id="archive" look="spot"
          ><span {...stylex.attrs(key, styles.plain)}>Archive</span></QuizChoice
        >
        <QuizChoice level={guard.levels[0]} id="delete" look="spot"
          ><span {...stylex.attrs(key, styles.red)}>Delete</span></QuizChoice
        >
      </span>
    </div>
  </RuleQuiz>

  <RuleLesson lesson={icons}>
    <Fragment slot="body"
      >Take 4px off the icon's side. An icon has white space inside its own box, so equal padding makes that side look wider.</Fragment
    >
    <ButtonToggle slot="extra" label="Show padding" name="pads" />
    <ButtonIcons slot="bad" />
    <ButtonIcons slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={6} level={icons.levels[0]}
    >Every button in this toolbar has 16px of padding on both sides. Tap the one that will look lopsided.
    <div slot="board" {...stylex.attrs(quiz.screen)}>
      <span {...stylex.attrs(quiz.bar)}>
        <QuizChoice level={icons.levels[0]} id="text" look="spot"
          ><span {...stylex.attrs(quiz.ruled)}
            ><span {...stylex.attrs(key, styles.plain, styles.even)}>Save<Ruler pads={[16, 16]} /></span></span
          ></QuizChoice
        >
        <QuizChoice level={icons.levels[0]} id="lead" look="spot"
          ><span {...stylex.attrs(quiz.ruled)}
            ><span {...stylex.attrs(key, styles.tint, styles.even)}
              ><Icon name="Plus" size="1em" weight="bold" aria-hidden="true" {...stylex.attrs(styles.icon)} />New project<Ruler
                pads={[16, 16]}
              /></span
            ></span
          ></QuizChoice
        >
        <QuizChoice level={icons.levels[0]} id="only" look="spot"
          ><span {...stylex.attrs(quiz.ruled)}
            ><span {...stylex.attrs(key, styles.plain, styles.even)}
              ><Icon name="MagnifyingGlass" size="1em" weight="bold" aria-hidden="true" {...stylex.attrs(styles.icon)} /><Ruler
                pads={[16, 16]}
              /></span
            ></span
          ></QuizChoice
        >
      </span>
    </div>
  </RuleQuiz>
</RuleLanding>
