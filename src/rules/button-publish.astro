---
import Icon from "../components/icon.astro";
import { styles } from "./button-design.css";
import { TAKEN, view } from "./button-design.view";

type Props = { careful?: boolean };

const { careful = false } = Astro.props;
// The first frame: the slug is taken, so Publish is off and says why.
const tipId = "publish-tip";
---

<button-publish
  class:list={[styles.stage, styles.form]}
  data-careful={careful ? "true" : undefined}
>
  <label class:list={[styles.field, styles.fullRow]}>
    <span>Title</span>
    <input value="Spring launch" class={styles.input} />
  </label>
  <label class={styles.field}>
    <span>URL</span>
    <span class:list={[styles.input, styles.slug]}
      ><span aria-hidden="true" class={styles.slugBase}>/blog/</span><input
        value={TAKEN}
        aria-label="URL after /blog/"
        spellcheck="false"
        class={styles.slugInput}
        data-part="slug"
      /></span
    >
  </label>
  {
    careful ? (
      <span class:list={[styles.tip, styles.formEnd]}
        ><button
          data-hint="true"
          type="button"
          class={view.publish(true, false)}
          aria-disabled="true"
          aria-describedby={tipId}
          data-part="publish">Publish</button
        ><span role="tooltip" id={tipId} class={view.tooltip(false)} data-part="tip"
          >That URL is taken</span
        ></span
      >
    ) : (
      <button
        data-hint="true"
        type="button"
        class={view.publish(false, false)}
        disabled
        data-part="publish">Publish</button
      >
    )
  }
  <template data-part="check"
    ><Icon name="Check" size="1em" weight="bold" class={styles.icon} /></template
  >
</button-publish>

<script>
  import "./button-publish.client";
</script>
