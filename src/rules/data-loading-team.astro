---
import { HINT } from "./hints";
import { button } from "../components/button.css";
import { buttonVariant } from "../components/button.view";
import { TEAM } from "./data-loading";
import { styles } from "./data-loading.css";
import { view } from "./data-loading.view";

type Props = {
  /** Show a failure in the card with Retry, instead of a toast over an empty card. */
  inline?: boolean;
};

const { inline = false } = Astro.props;
// The templates hold what a failure shows; data-loading-team.client.ts clones them.
---

<data-loading-team class={styles.view} data-inline={inline ? "" : undefined}
  ><div class={styles.card} data-part="card"
    ><div class={styles.head}
      ><span>Team</span><span class={styles.status}>3 members</span></div
    ><div class={styles.body} data-part="body"
      ><ul class={styles.people}
        >{
          TEAM.map(([name, role]) => (
            <li class={styles.person}
              ><i aria-hidden="true" class={styles.avatar}>{name.charAt(0)}</i><b
                class={styles.personName}>{name}</b
              ><span class={styles.personRole}>{role}</span></li
            >
          ))
        }</ul
      ></div
    ></div
  ><div class={styles.ctl}
    ><span class={styles.note}>The next request fails</span><button
      data-hint={HINT.tap}
      type="button"
      class={view.ctlButton}
      data-part="fail">Fail a request</button
    ></div
  ><template data-part="failed"
    >{
      inline ? (
        <div class={styles.error} role="alert"
          ><b class={styles.errorTitle}>Couldn't load the team.</b><span
            class={styles.errorText}>The server didn't answer. Your other cards are fine.</span
          ><button
            type="button"
            class:list={[button.base, buttonVariant["secondary-hue"], button.sm, styles.errorButton]}
            data-part="retry">Retry</button
          ><code class={styles.errorCode}>logged · req 7f3a</code></div
        >
      ) : (
        <p class={styles.empty}>No members yet</p>
      )
    }</template
  ><template data-part="toast"
    ><p class={styles.toast} role="status">Something went wrong</p></template
  ></data-loading-team
>

<script>
  import "./data-loading-team.client";
</script>
