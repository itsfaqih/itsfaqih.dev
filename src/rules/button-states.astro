---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./button-design.styles";

type Props = { careful?: boolean };

const { careful = false } = Astro.props;
const FORCED = {
  idle: null,
  hover: styles.hover,
  press: styles.press,
  focus: styles.focus,
};
---

<div {...stylex.attrs(styles.stage)}>
  <button data-hint="true" type="button" {...stylex.attrs(styles.key, careful ? styles.live : styles.flat)}
    >Save changes</button
  >
  <div {...stylex.attrs(styles.specimens)} aria-hidden="true">
    {
      (["idle", "hover", "press", "focus"] as const).map((state) => (
        <span {...stylex.attrs(styles.specimen)}
          ><span
            {...stylex.attrs(
              styles.key,
              styles.sm,
              styles.specimenKey,
              FORCED[state],
              !careful && styles.flatForced,
            )}>Save</span
          ><small {...stylex.attrs(styles.small)}>{state}</small></span
        >
      ))
    }
  </div>
</div>
