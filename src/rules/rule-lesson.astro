---
import { type ClassValue } from "../cx";
import { arcade } from "../components/arcade.css";
import type { Lesson } from "./lesson";
import { hintKit, host, lessonKit, text } from "./rule-landing.css";
import { lessonView, type SideKey } from "./rule-landing.view";

type Props = {
  lesson: Lesson;
  /** The most tree rows either pane shows, which sizes the panes on phones; 0 for other demos. */
  rows?: number;
  /** Applied last to the row of cost tags under each pane. */
  costsClass?: ClassValue;
};

const { lesson, rows = 0, costsClass } = Astro.props;
const SIDES: readonly SideKey[] = ["bad", "good"];
const MARK = { bad: "✕", good: "✓" } as const;
// Slots: "body" (the lesson copy, its code in tone "chip"), "extra" (a block under it), and "bad"
// and "good" (each pane's demo). The panes start on "good", as rule-lesson.client.ts expects.
---

<rule-lesson class={host.contents}>
  <article class={lessonView.article} data-rev="true">
    <div class={lessonKit.copy}>
      {lesson.exception && <span class={lessonKit.exception}>Exception</span>}
      <h3 class={lessonKit.title}>{lesson.title}</h3>
      <p class={text.lesson}><slot name="body" /></p>
      <slot name="extra" />
    </div>
    <div data-show="good" style={`--rows:${rows}`} class={lessonKit.demo} data-part="demo">
      <div
        role="group"
        aria-label={`${lesson.title}: compare`}
        class={lessonKit.flip}
      >
        {
          SIDES.map((key) => (
            <button
              type="button"
              aria-pressed={key === "good" ? "true" : "false"}
              class={lessonView.flipKey(key, key === "good")}
              data-part={key}
              ><span aria-hidden="true" class={lessonKit.mark}>{MARK[key]}</span>{
                lesson[key].label
              }</button
            >
          ))
        }
      </div>
      {
        SIDES.map((key) => (
          <figure data-side={key} class={lessonView.pane(key === "good")}>
            <figcaption class:list={[lessonKit.caption, lessonKit[key]]}
              ><span aria-hidden="true" class={lessonKit.mark}>{MARK[key]}</span><span
                class={arcade.srOnly}>{key === "bad" ? "Avoid: " : "Do: "}</span
              >{lesson[key].label}</figcaption
            >
            {key === "bad" ? <slot name="bad" /> : <slot name="good" />}
            <div class:list={[lessonKit.costs, costsClass]}>
              {lesson[key].costs.map((cost) => (
                <span class:list={[lessonKit.cost, lessonKit.costIn, lessonKit[`${key}Cost`]]}>
                  {cost}
                </span>
              ))}
            </div>
          </figure>
        ))
      }
    </div>
    <div data-hint-layer="true" aria-hidden="true" class={hintKit.layer} data-part="hints"
      ><span class:list={[hintKit.label, hintKit.ruler]} data-part="ruler">Try it</span></div
    >
  </article>
</rule-lesson>

<script>
  import "./rule-lesson.client";
</script>
