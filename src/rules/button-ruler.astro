---
import { styles } from "./button-design.css";

type Props = {
  pads: [left: number, right: number];
};

const { pads } = Astro.props;
---

<span aria-hidden="true" class={styles.dims}
  ><span class:list={[styles.dim, styles.dimLeft]}>{pads[0]}</span><span
    class:list={[styles.dim, styles.dimRight]}>{pads[1]}</span
  ></span
>
