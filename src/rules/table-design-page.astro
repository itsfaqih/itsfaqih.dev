---
import Icon from "../components/icon.astro";
import Code from "./code.astro";
import RuleLanding from "./rule-landing.astro";
import RuleLesson from "./rule-lesson.astro";
import QuizChoice from "./quiz-choice.astro";
import RuleQuiz from "./rule-quiz.astro";
import { FILTERS, LESSONS, START_FILTER, TLDR, VIEW_NAMES } from "./table-design";
import { quiz, styles } from "./table-design.css";
import { quizKit } from "./rule-landing.css";
import TableActions from "./table-actions.astro";
import TableLive from "./table-live.astro";
import TableNumbers from "./table-numbers.astro";
import TablePager from "./table-pager.astro";
import TableSegments from "./table-segments.astro";
import TableStates from "./table-states.astro";
import TableUrl from "./table-url.astro";

const [numbers, states, actions, pager, url] = LESSONS;
const sizes = [
  ["report.pdf", "120"],
  ["backup.zip", "12,500"],
  ["notes.txt", "9"],
] as const;
const blanks = [
  { id: "create", title: "No invoices yet", hint: "Create your first invoice.", act: "New invoice" },
  { id: "ask", title: "No invoices yet", hint: "Only admins can create them.", act: "Ask an admin" },
  { id: "refresh", title: "Nothing to show", hint: "Check back later.", act: "Refresh" },
] as const;
const filters = [
  { id: "25", caption: "Shipped, 25 orders", orders: ["#1042", "#1039", "#1031"], total: 25 },
  { id: "31", caption: "All, 31 orders", orders: ["#1044", "#1043", "#1042"], total: 31 },
  { id: "0", caption: "Refunded, 0 orders", orders: [], total: 0 },
] as const;
const shown = 3;
const cells = [
  { spot: "first" },
  { text: "Desk lamp, brass", spot: "name" },
  { text: "$48.00", role: true },
  { spot: "last" },
] as const;
---

<RuleLanding id="table-design" learn="Design tables for scanning" tldr={TLDR} take="build tables the same way">
  <Fragment slot="lead">Right-align numbers, pin actions to a fixed last column, and give every blank a next step.</Fragment>
  <Fragment slot="intro">Make each column easy to run an eye down, since people scan for one value.</Fragment>

  <RuleLesson lesson={numbers} costsClass={styles.costs}>
    <Fragment slot="body"
      >People compare numbers by their last digits. Use tabular figures so every digit is the same width, and add thousands separators. Watch the right edge.</Fragment
    >
    <TableLive slot="extra" />
    <TableNumbers slot="bad" careful={false} />
    <TableNumbers slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={1} level={numbers.levels[0]}
    >A size column in KB holds <Code tone="prompt">9</Code>, <Code tone="prompt">120</Code> and <Code tone="prompt">12,500</Code>, and people scan it for the biggest file. Pick the column where the biggest stands out.
    <div slot="board" class={quizKit.trio}>
      {
        (
          [
            ["left", "Left", quiz.left],
            ["center", "Centre", quiz.center],
            ["right", "Right", quiz.right],
          ] as const
        ).map(([id, caption, align]) => (
          <QuizChoice level={numbers.levels[0]} id={id} caption={caption}
            ><span class:list={[quiz.sheet, quiz.money]}
              ><span class={quiz.th}>File</span><span class:list={[quiz.th, align]}>KB</span>{
                sizes.map(([file, value], at) => (
                  <Fragment
                    ><span class:list={[quiz.td, at === 0 && quiz.top]}>{file}</span><span
                      class:list={[quiz.td, align, at === 0 && quiz.top]}>{value}</span
                    ></Fragment
                  >
                ))
              }</span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={states} costsClass={styles.costs}>
    <Fragment slot="body"
      >A table is often loading, empty, failed or showing no matches. Draw each one. Use skeleton rows to keep the shape while it loads, and say why and what to do next in every blank. Pick a state, search, then press the buttons.</Fragment
    >
    <TableSegments slot="extra" label="Table state" options={VIEW_NAMES} value="empty" of="roster" />
    <TableStates slot="bad" careful={false} />
    <TableStates slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={2} level={states.levels[0]}
    >A viewer, who can read invoices but not create them, opens the invoices table. There are none yet. Pick what they should see.
    <div slot="board" class={quizKit.trio}>
      {
        blanks.map(({ id, title, hint, act }) => (
          <QuizChoice level={states.levels[0]} id={id}
            ><span class={quiz.sheet}
              ><span class={quiz.bar}
                ><span class={quiz.search}
                  ><Icon
                    name="MagnifyingGlass"
                    size="1em"
                    weight="bold"
                    aria-hidden="true"
                    class={quiz.glyph}
                  />Search invoices</span
                ></span
              ><span class={quiz.people}
                ><span class={quiz.th}>Customer</span><span class={quiz.th}>Total</span></span
              ><span class={quiz.said}
                ><span class={quiz.saidTitle}>{title}</span><span class={quiz.saidHint}>{hint}</span
                ><span class={quiz.key}>{act}</span></span
              ></span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={actions} costsClass={styles.costs}>
    <Fragment slot="body"
      >Give the column a fixed width and right-align it, so Edit sits in the same place on every row. Use icon buttons to save room, and name each one with a tooltip. Hover the rows, then delete one.</Fragment
    >
    <TableActions slot="bad" careful={false} />
    <TableActions slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={3} level={actions.levels[0]}
    >Each product row gets <b>Edit</b> and <b>Delete</b>. Product names run from 4 to 30 characters. Tap where the buttons go.
    <div slot="board" class:list={[quiz.screen, quiz.row]}>
      <span class={quiz.head}></span>
      <span class={quiz.head}>Product</span>
      <span class:list={[quiz.head, quiz.roomy]}>Price</span>
      <span class={quiz.head}></span>
      {
        cells.map((cell) => (
          <span class:list={[quiz.cell, "role" in cell && [quiz.dim, quiz.roomy]]}
            >{"text" in cell && cell.text}{
              "spot" in cell && (
                <QuizChoice level={actions.levels[0]} id={cell.spot} look="spot"
                  ><span class={quiz.ghostKeys}
                    ><Icon
                      name="PencilSimple"
                      size="1em"
                      weight="bold"
                      aria-hidden="true"
                      class={quiz.ghostKey}
                    /><Icon name="Trash" size="1em" weight="bold" aria-hidden="true" class={quiz.ghostKey} /></span
                  ></QuizChoice
                >
              )
            }</span
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={pager} costsClass={styles.costs}>
    <Fragment slot="body"
      >With one page, a pager is a row of dead arrows. Under an empty table, it reads Page 1 of 0. Filter the list and watch both.</Fragment
    >
    <TableSegments slot="extra" label="Filter by role" options={FILTERS} value={START_FILTER} of="filter" />
    <TablePager slot="bad" careful={false} />
    <TablePager slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={4} level={pager.levels[0]}
    >The orders table shows 25 rows per page. Three filters return 25, 31 and 0 orders. Pick the table that needs a pager.
    <div slot="board" class={quizKit.trio}>
      {
        filters.map(({ id, caption, orders, total }) => (
          <QuizChoice level={pager.levels[0]} id={id} caption={caption}
            ><span class={quiz.sheet}
              ><span class={quiz.th}>Order</span>{
                orders.map((order, at) => (
                  <span class:list={[quiz.td, at === 0 && quiz.top]}
                    ><span class={quiz.clip}>{order}</span></span
                  >
                ))
              }{
                total === 0 ? (
                  <span class={quiz.said}
                    ><span class={quiz.saidTitle}>No refunds</span><span class={quiz.saidHint}
                      >No order has been refunded yet.</span
                    ></span
                  >
                ) : (
                  <span class:list={[quiz.td, quiz.more]}>{total - shown} more rows</span>
                )
              }<span class={quiz.ghostPager}
                ><Icon name="CaretLeft" size="1em" weight="bold" aria-hidden="true" class={quiz.glyph} /><span
                  class={quiz.ghostPage}></span
                ><Icon name="CaretRight" size="1em" weight="bold" aria-hidden="true" class={quiz.glyph} /></span
              ></span
            ></QuizChoice
          >
        ))
      }
    </div>
  </RuleQuiz>

  <RuleLesson lesson={url} costsClass={styles.costs}>
    <Fragment slot="body"
      >With <Code tone="chip">?page=2</Code> in the address, a reload, the Back button and a shared link all land where you were. Reload each.</Fragment
    >
    <TableUrl slot="bad" careful={false} />
    <TableUrl slot="good" careful />
  </RuleLesson>
  <RuleQuiz n={5} level={url.levels[0]}
    >You're on page 3 of the orders and send the link to a teammate. Tap where the page number should live.
    <div slot="board" class={quiz.screen}>
      <div class={quiz.chrome}>
        <span class={quiz.reload}
          ><Icon name="ArrowClockwise" size="1em" weight="bold" aria-hidden="true" class={quiz.ghostKey} /></span
        >
        <QuizChoice level={url.levels[0]} id="url" look="spot"
          ><span class={quiz.address}><span class={quiz.host}>acme.app</span>/orders</span></QuizChoice
        >
      </div>
      <div class={quiz.page}>
        <QuizChoice level={url.levels[0]} id="state" look="spot"
          ><span class:list={[quiz.sheet, quiz.people]}
            ><span class={quiz.th}>Order</span><span class={quiz.th}>Total</span>{
              (
                [
                  ["#1027", "$84.00"],
                  ["#1028", "$12.50"],
                  ["#1029", "$230.00"],
                ] as const
              ).map(([order, total], at) => (
                <Fragment
                  ><span class:list={[quiz.td, at === 0 && quiz.top]}>{order}</span><span
                    class:list={[quiz.td, quiz.right, at === 0 && quiz.top]}>{total}</span
                  ></Fragment
                >
              ))
            }</span
          ><span class={quiz.pager}
            ><span>Page 3 of 5</span><span class={quiz.pages}
              >{
                [1, 2, 3, 4, 5].map((n) => <span class:list={[quiz.pageKey, n === 3 && quiz.pageOn]}>{n}</span>)
              }</span
            ></span
          ></QuizChoice
        >
      </div>
      <div class={quiz.drawer}>
        <QuizChoice level={url.levels[0]} id="storage" look="spot"
          ><span class={quiz.drawerTitle}>Storage, acme.app</span><span class:list={[quiz.sheet, quiz.store]}
            ><span class={quiz.th}>Key</span><span class={quiz.th}>Value</span><span
              class:list={[quiz.td, quiz.top, quiz.dim]}>theme</span
            ><span class:list={[quiz.td, quiz.top, quiz.dim]}>dark</span></span
          ></QuizChoice
        >
      </div>
    </div>
  </RuleQuiz>
</RuleLanding>
