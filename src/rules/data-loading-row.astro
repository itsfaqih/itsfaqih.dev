---
import { styles } from "./data-loading.css";
import { isTimed } from "./data-loading";
import type { BoardRow } from "./lesson";

type Props = { text: string; row: BoardRow };

const { text, row } = Astro.props;
---

{isTimed(row) ? <Fragment><time class={styles.time}>{row.at}</time>{text}</Fragment> : text}
