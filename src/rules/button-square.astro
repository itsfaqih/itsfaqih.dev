---
import Icon from "../components/icon.astro";
import { styles } from "./button-design.css";
import Ruler from "./button-ruler.astro";

type Props = { careful?: boolean };

const { careful = false } = Astro.props;
const text = [styles.key, styles.sm, styles.live, styles.plain, styles.ring];
const key = [...text, styles.iconOnly, careful ? styles.square : styles.tall];
const side = careful ? 11 : 16;
const ACTIONS = [
  ["Edit", "PencilSimple"],
  ["Share", "ShareNetwork"],
  ["Delete", "Trash"],
] as const;
---

<div class:list={[styles.stage, styles.icons]}>
  <button type="button" class:list={text}>Reply<Ruler pads={[16, 16]} /></button>
  {
    ACTIONS.map(([label, icon], i) => (
      <button type="button" aria-label={label} class:list={key}>
        <Icon name={icon} size="1em" weight="bold" aria-hidden="true" class={styles.icon} />
        <Ruler pads={[side, side]} top={i === ACTIONS.length - 1 ? side : undefined} />
      </button>
    ))
  }
</div>
