---
import { arcade } from "../components/arcade.css";
import { AXIS, SWEEP, type Waterfall } from "./data-loading";
import { styles } from "./data-loading.css";
import { view } from "./data-loading.view";

type Props = Waterfall;

const { bars, paint } = Astro.props;
const pct = (ms: number) => `${(ms / AXIS) * 100}%`;
const deferred = bars.some((bar) => bar.kind === "defer");
---

<data-loading-waterfall class={styles.view}
  ><div class={styles.wf} style={`--sweep:${SWEEP}ms`}
    ><ul class={styles.lanes} aria-hidden="true"
      >{bars.map((bar) => <li class={styles.label}>{bar.label}</li>)}</ul
    ><div class={styles.plot} data-part="plot"
      ><ul class={styles.lanes}
        >{
          bars.map((bar) => (
            <li class={styles.lane}
              ><span
                class:list={[styles.bar, styles[bar.kind]]}
                style={`left:${pct(bar.from)};width:${pct(bar.to - bar.from)}`}></span
              ><span class={arcade.srOnly}
                ><Fragment
                  set:html={`${bar.label}<!-- -->: <!-- -->${bar.from}<!-- --> to <!-- -->${bar.to}<!-- -->ms${bar.kind === "defer" ? "<!-- -->, deferred" : ""}`}
                /></span
              ></li
            >
          ))
        }</ul
      ><span
        class={view.paint("still")}
        style={`left:${pct(paint)};--at:${(paint / AXIS) * SWEEP}ms`}
        data-part="paint"
        ><b class:list={[styles.paintTag, paint > AXIS * 0.6 && styles.paintTagEnd]}
          ><span class={styles.long}>on screen </span>{paint}<!-- -->ms</b
        ></span
      ><span class={view.cover("still")} aria-hidden="true" data-part="cover"></span><span
        class={styles.grid}
        aria-hidden="true"></span
      ></div
    ><span class={styles.axis} aria-hidden="true"
      >{
        [0, 250, 500, 750, 1000].map((ms) => (
          <i class={styles.tick} style={`left:${pct(ms)}`}>{ms}</i>
        ))
      }</span
    ></div
  ><div class={styles.ctl}
    ><span class={styles.note}
      ><i class:list={[styles.key, styles.keyReq]}></i> request<!-- --> <i
        class:list={[styles.key, styles.keyCode]}></i> code{
        deferred && (
          <Fragment><i class:list={[styles.key, styles.keyDefer]}></i> deferred</Fragment>
        )
      }</span
    ><button data-hint="true" type="button" class={view.ctlButton} data-part="replay">Replay</button
    ></div
  ></data-loading-waterfall
>

<script>
  import "./data-loading-waterfall.client";
</script>
