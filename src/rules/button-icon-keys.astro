---
import * as stylex from "@stylexjs/stylex";
import Icon from "../components/icon.astro";
import { styles, marker } from "./button-design.styles";
import Ruler from "./button-ruler.astro";

type Props = { careful?: boolean };

const { careful = false } = Astro.props;
const TOOLS = [
  { label: "Settings", icon: "GearSix" },
  { label: "Notifications", icon: "Bell" },
] as const;
const key = [styles.key, styles.sm, styles.live, styles.plain];
---

<div {...stylex.attrs(styles.stage, styles.icons)}>
  {
    TOOLS.map(({ label, icon }, at) =>
      careful ? (
        <span {...stylex.attrs(styles.tip)}
          ><button
            type="button"
            {...stylex.attrs(key, styles.square, marker)}
            data-hint={at === 0 ? "true" : undefined}
            aria-label={label}
            aria-describedby={`icon-keys-tip-${label}`}
            ><Icon
              name={icon}
              size="1em"
              weight="bold"
              aria-hidden="true"
              {...stylex.attrs(styles.icon)}
            /><Ruler width={38} /></button
          ><span role="tooltip" id={`icon-keys-tip-${label}`} {...stylex.attrs(styles.tooltip)}
            >{label}</span
          ></span
        >
      ) : (
        <button
          type="button"
          data-hint={at === 0 ? "true" : undefined}
          {...stylex.attrs(key, styles.padded)}
          aria-label={label}
          ><Icon
            name={icon}
            size="1em"
            weight="bold"
            aria-hidden="true"
            {...stylex.attrs(styles.icon)}
          /><Ruler pads={[14, 14]} /></button
        >
      ),
    )
  }
</div>
