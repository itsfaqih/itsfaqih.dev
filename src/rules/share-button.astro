---
import Icon from "../components/icon.astro";
import { arcade } from "../components/arcade.css";
import { button } from "../components/button.css";
import { buttonVariant } from "../components/button";
import { veil } from "../sections/section.css";
import { glyphSwap, island, shell } from "./rule-landing.css";
import { landingView } from "./rule-landing.view";

type Props = {
  /** The header island's icon-only button. */
  inIsland?: boolean;
};

const { inIsland = false } = Astro.props;
// rule-landing.client.ts swaps the glyphs and the label while the link is copied.
---

<button
  type="button"
  class:list={inIsland
    ? island.action
    : [button.base,
      buttonVariant["tertiary-neutral"],
      button.sm,
      veil.dense,
      shell.share,
      shell.in,
      shell.first]}
  data-part="share"
  ><span aria-hidden="true" class={glyphSwap.cell}
    ><Icon name="ShareNetwork" size={16} weight="bold" class={landingView.glyph(true)} data-part="glyph" /><Icon
      name="Check"
      size={16}
      weight="bold"
      class={landingView.glyph(false)}
      data-part="glyph"
    /></span
  ><span aria-live="polite" class={inIsland ? arcade.srOnly : shell.shareLabel} data-part="label">Share</span></button
>
