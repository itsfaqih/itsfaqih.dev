---
import Code from "./code.astro";
import { codeCell } from "./handling-timestamps";

type Props = { text: string; tone: "plain" | "wrap" };

const { text, tone } = Astro.props;
const code = codeCell(text);
// React's Code took tone "wrap" inside a slot button and no tone on the board around it.
---

{code === undefined ? text : tone === "wrap" ? <Code tone="wrap">{code}</Code> : <code>{code}</code>}
