---
import Code from "./code.astro";
import { codeCell } from "./handling-timestamps";

type Props = { part: "text" | "lead" | "label"; value: string };

const { part, value } = Astro.props;
const code = codeCell(value);
// React's Code took tone "wrap" inside a slot button and no tone on the board around it.
---

{code === undefined ? value : part === "label" ? <Code tone="wrap">{code}</Code> : <code>{code}</code>}
