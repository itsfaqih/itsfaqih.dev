---
import type { Job } from "./home-content";
import { boxScrollbar } from "../components/box-scrollbar.css";
import { marker as barMarker } from "../when";
import { loadIn } from "../components/load-in.css";
import { techBrand } from "./tech-brand";
import { marker } from "../when";
import { moreLabel, rowView } from "./experience-list.view";
import { styles } from "./experience-list.css";
import CompanyLogo from "./company-logo.astro";
import TechIcon from "./tech-icon.astro";

// The work history (experience-list.client.ts): one row per job, one open at a time, with the
// open row's achievements. Each row keeps its achievements in a template for when it opens.
type Props = { jobs: Job[] };

const { jobs } = Astro.props;
---

<experience-list class={styles.list}
  >{
    jobs.map((job, index) => {
      const isOpen = index === 0;
      const view = rowView(isOpen);
      const achievements = () => (
        <ul class={styles.achievements}>
          {job.achievements.map((item, at) => (
            <li class={styles.achievement} style={`--j:${at}`}>{item}</li>
          ))}
        </ul>
      );
      return (
        <div
          class:list={[loadIn.piece, styles.row, marker]}
          data-cut="true"
          data-on={isOpen ? "" : undefined}
        >
          <button
            type="button"
            class={view.head}
            aria-expanded={isOpen ? "true" : "false"}
            aria-controls={`job-${index}`}
          >
            <span class={styles.years}>{job.years}</span>
            <h3 class={view.company}><CompanyLogo name={job.company} class={styles.logo} />{job.company}<small class={styles.role}>{job.role}</small></h3>
            <span class={view.chevron} aria-hidden="true" />
          </button>
          <div data-stack="true" class={view.frame}>
            <ul class={view.stack} aria-label={`${job.company} stack`}>
              {job.stack.map((tool) => (
                <li data-tool="true" class={view.pill} style={techBrand(tool)}><TechIcon name={tool} class={isOpen ? styles.markOpen : styles.markClosed} />{tool}</li>
              ))}
              <li data-more="true" style="display:none"><span data-label={moreLabel(0)} class={view.more} aria-label="0 more tools" /></li>
            </ul>
            <div hidden aria-hidden="true" class:list={[boxScrollbar.track, styles.stackBar, barMarker]}>
              <div class={boxScrollbar.thumb} />
            </div>
          </div>
          <div id={`job-${index}`} data-body="true" class={styles.body}>{isOpen && achievements()}</div>
          <template>{achievements()}</template>
        </div>
      );
    })
  }</experience-list
>

<script>
  import "./experience-list.client";
</script>
