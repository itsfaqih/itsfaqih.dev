---
import { cx, type ClassValue } from "../cx";
import { colorOf, type Guideline } from "../data/guidelines";
import { beat, button, dataLoading, depth, draw, glyph, nullish, proximity, screen } from "./rule-thumb.css";

type Stroke = { tag: "path" | "rect" | "circle"; attrs: Record<string, string> };

// Each topic's glyph on a 24-unit grid, for rules without art of their own.
const GLYPHS = new Map<string, Stroke[]>([
  ["Code Writing", [{ tag: "path", attrs: { d: "M8 6l-6 6 6 6M16 6l6 6-6 6" } }]],
  ["UX Design", [{ tag: "path", attrs: { d: "M5 3l6.5 17 2.5-7 7-2.5z" } }]],
  [
    "Architecture",
    [
      { tag: "rect", attrs: { x: "3", y: "3", width: "7", height: "7", rx: "1" } },
      { tag: "rect", attrs: { x: "14", y: "3", width: "7", height: "7", rx: "1" } },
      { tag: "rect", attrs: { x: "8.5", y: "14", width: "7", height: "7", rx: "1" } },
      { tag: "path", attrs: { d: "M6.5 10v2h11v-2M12 12v2" } },
    ],
  ],
  [
    "Best Practices",
    [
      { tag: "circle", attrs: { cx: "12", cy: "12", r: "9" } },
      { tag: "path", attrs: { d: "M8 12.5l2.5 2.5L16 9" } },
    ],
  ],
  [
    "Accessibility",
    [
      { tag: "circle", attrs: { cx: "12", cy: "4.5", r: "1.8" } },
      { tag: "path", attrs: { d: "M5 8.5l7 1.5 7-1.5M12 10v5M9 21l3-6 3 6" } },
    ],
  ],
]);

const glyphOf = (label: string) => GLYPHS.get(label) ?? GLYPHS.get("Best Practices")!;

/** The rules with art of their own; every other rule shows its topic's glyph. */
const ART_IDS = new Set([
  "proximity-principle",
  "button-design",
  "data-loading",
  "null-vs-undefined",
]);

// The progress pips fill one by one; the first is lit throughout.
const PIP_PLAY = [null, button.pip2Play, button.pip3Play, button.pip4Play, button.pip5Play];

type Props = {
  /** With no rule the screen is blank. */
  rule?: Guideline;
  /** The art plays while the screen carries data-play; its owner toggles it at runtime. */
  play?: boolean;
  /** Where the screen sits. The select panel and a rule's cover show it large, with a bigger chip. */
  at?: "card" | "panel" | "cover";
  style?: ClassValue;
};

const { rule, play = false, at = "card", style } = Astro.props;
const art = rule && ART_IDS.has(rule.id) ? rule.id : undefined;
// On a rule's cover the art sits in layers (depth), and the data-loading screen takes that page's
// demo card styles, and its slide in place of the sweep.
const z = at === "cover";
const playing = art === "button-design" ? draw.playSlow : draw.play;
const chip = art
  ? {
      "proximity-principle": { beats: ["FAR", "NEAR"], moves: [beat.away, beat.rest] },
      "button-design": {
        beats: ["IDLE", "HOVER", "PRESS", "LOAD", "DONE"],
        moves: [beat.idle, beat.hover, beat.press, beat.load, beat.done],
      },
      "data-loading": { beats: ["STALE", "FRESH"], moves: [beat.away, beat.rest] },
      "null-vs-undefined": { beats: ["MISSING", "EMPTY"], moves: [beat.missing, beat.empty] },
    }[art]
  : undefined;
const rows = [
  { y: 34, width: 50, value: "$12" },
  { y: 52, width: 38, value: "$14" },
  { y: 70, width: 58, value: "$31" },
];
---

<div
  class={`thumb ${cx(screen.root, !rule && screen.blank, z && depth.dots, style)}`}
  style={rule && `--c:${colorOf(rule.label)}`}
  aria-hidden="true"
  data-play={play ? "" : undefined}
>
  {
    rule && !art && (
      <div class:list={[screen.art, glyph.box, playing]}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class:list={[glyph.svg, playing, glyph.float, z && depth.near]}
        >
          {
            glyphOf(rule.label).map(({ tag: Stroke, attrs }) => (
              <Stroke class:list={[playing]} {...attrs} />
            ))
          }
        </svg>
      </div>
    )
  }
  {
    art && (
      <div class:list={[screen.art, playing]}>
        {art === "proximity-principle" && (
          <svg viewBox="0 0 160 100" class:list={[draw.svg, playing]}>
            <rect
              class:list={[proximity.box,
                draw.moving,
                playing,
                proximity.boxPlay,
                z && depth.back]}
              x="14"
              y="21"
              width="108"
              height="46"
              rx="6"
            />
            <text class:list={[draw.text, draw.dim, playing, z && depth.back]} x="14" y="15">src/</text>
            <text class:list={[draw.text, draw.hi, playing, z && depth.mid]} x="22" y="33">OrderCard/</text>
            <text class:list={[draw.text, playing, z && depth.mid]} x="32" y="47">OrderCard.tsx</text>
            <text class:list={[draw.text, draw.dim, playing, z && depth.mid]} x="22" y="77">shared/</text>
            <line
              class:list={[proximity.link,
                draw.moving,
                playing,
                proximity.linkPlay,
                z && depth.mid]}
              x1="27"
              y1="50"
              x2="27"
              y2="89"
            />
            <g class:list={[draw.moving, playing, proximity.filePlay, z && depth.front]}>
              <rect
                class:list={[proximity.file, playing]}
                x="30"
                y="52"
                width="56"
                height="12"
                rx="3"
              />
              <text class:list={[draw.text, proximity.fileName, playing]} x="34" y="61">styles.ts</text>
            </g>
          </svg>
        )}
        {art === "button-design" && (
          <svg viewBox="0 0 160 100" class:list={[draw.svg, playing]}>
            <g class:list={[button.button, draw.moving, playing, button.buttonPlay, z && depth.mid]}>
              <rect
                class:list={[button.face, draw.moving, playing]}
                x="38"
                y="30"
                width="84"
                height="28"
                rx="8"
              />
              <rect
                class:list={[button.hover, draw.moving, playing, button.hoverPlay]}
                x="38"
                y="30"
                width="84"
                height="28"
                rx="8"
              />
              <text
                class:list={[button.text, button.hidden, draw.moving, playing, button.idlePlay]}
                x="80"
                y="48">Save</text>
              <g class:list={[button.hidden, draw.moving, playing, button.pendingPlay]}>
                <circle
                  class:list={[button.spinner, draw.moving, playing, button.spinnerPlay]}
                  cx="52"
                  cy="44"
                  r="5"
                />
                <text class:list={[button.text, button.pendingText, playing]} x="88" y="47.5">Saving…</text>
              </g>
              <text class:list={[button.text, draw.moving, playing, button.donePlay]} x="80" y="48">Saved ✓</text>
            </g>
            {PIP_PLAY.map((pipPlay, index) => (
              <rect
                class:list={[button.pip, draw.moving, playing, pipPlay, z && depth.back]}
                x={52 + index * 12}
                y="72"
                width="8"
                height="4"
                rx="2"
              />
            ))}
            <path
              class:list={[button.cursor, draw.moving, playing, button.cursorPlay, z && depth.front]}
              d="M100 46l0 16 4.5-4.2 3 6.6 2.6-1.2-3-6.4 6-.4z"
            />
          </svg>
        )}
        {art === "data-loading" && (
          <svg viewBox="0 0 160 100" class:list={[draw.svg, playing]}>
            <rect
              class:list={[dataLoading.card, z && dataLoading.ownCard, draw.moving, playing, z && depth.back]}
              x="22"
              y="16"
              width="116"
              height="72"
              rx="8"
            />
            <rect
              class:list={[dataLoading.flash, draw.moving, playing, dataLoading.flashPlay, z && depth.mid]}
              x="24"
              y="44"
              width="112"
              height="16"
              rx="3"
            />
            <g class:list={[draw.moving, playing, dataLoading.rowsPlay, z && depth.mid]}>
              {rows.map((row, index) => (
                <g class:list={[playing]}>
                  <circle class:list={[dataLoading.mark, playing]} cx="36" cy={row.y + 2} r="4" />
                  <rect
                    class:list={[dataLoading.mark, playing]}
                    x="46"
                    y={row.y - 1}
                    width={row.width}
                    height="6"
                    rx="3"
                  />
                  <text
                    class:list={[draw.text,
                      draw.hi,
                      dataLoading.value,
                      index === 1 && draw.moving,
                      playing,
                      index === 1 && dataLoading.newPlay]}
                    x="130"
                    y={row.y + 5}>{row.value}</text>
                </g>
              ))}
            </g>
            <text
              class:list={[draw.text,
                dataLoading.value,
                dataLoading.old,
                draw.moving,
                playing,
                dataLoading.oldPlay,
                z && depth.mid]}
              x="130"
              y="57">$8</text>
            <rect
              class:list={[dataLoading.sweep,
                draw.moving,
                playing,
                z ? dataLoading.slidePlay : dataLoading.sweepPlay,
                z && depth.back]}
              x="22"
              y="16"
              width="116"
              height="3"
              rx="1.5"
            />
          </svg>
        )}
        {art === "null-vs-undefined" && (
          <svg viewBox="0 0 160 100" class:list={[draw.svg, playing]}>
            <rect
              class:list={[nullish.slot, draw.moving, playing, z && depth.back]}
              x="20"
              y="20"
              width="52"
              height="46"
              rx="8"
            />
            <text
              class:list={[nullish.mark,
                nullish.question,
                draw.moving,
                playing,
                nullish.questionPlay,
                z && depth.mid]}
              x="46"
              y="51">?</text>
            <rect
              class:list={[nullish.slot, draw.moving, playing, z && depth.back]}
              x="88"
              y="20"
              width="52"
              height="46"
              rx="8"
            />
            <g class:list={[draw.moving, playing, nullish.boxPlay, z && depth.front]}>
              <rect class:list={[nullish.box, playing]} x="91" y="23" width="46" height="40" rx="6" />
              <text class:list={[nullish.mark, playing]} x="114" y="51">∅</text>
            </g>
            <text
              class:list={[draw.text, draw.dim, nullish.label, draw.moving, playing, z && depth.back]}
              x="46"
              y="84">undefined</text>
            <text
              class:list={[draw.text, draw.hi, nullish.label, draw.moving, playing, z && depth.back]}
              x="114"
              y="84">null</text>
          </svg>
        )}
        {chip && (
          <span
            class:list={[screen.chip, at !== "card" && screen.chipLarge, z && depth.near, playing]}
          >
            {chip.beats.map((name, index) => (
              <b class:list={[screen.beat, playing, chip.moves[index]]}>{name}</b>
            ))}
          </span>
        )}
      </div>
    )
  }
</div>
