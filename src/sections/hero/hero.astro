---
import { SLIDES } from "../../data/home";
import { button } from "../../components/button.css";
import { buttonVariant } from "../../components/button.view";
import { loadIn } from "../../components/load-in.css";
import { heroType } from "../hero-type.css";
import { veil } from "../section.css";
import { SLIDE_MS } from "./hero-prints.view";
import { barClass, glyphClass, phraseClass } from "./hero.view";
import { marker } from "../../when";
import { styles } from "./hero.css";
import HeroPrints from "./hero-prints.astro";

// The home hero (hero.client.ts): the headline cycles through what I build, and the bench beside
// it shows each in print.
const current = SLIDES[0]!;
---

<home-hero class={styles.root}
  ><div class={veil.soft}
    ><div class:list={[loadIn.veil, veil.dense, heroType.tag]} data-cut="true"
      ><span class:list={[loadIn.piece, loadIn.words]} data-cut="true"
        >Full-stack engineer · Indonesia</span
      ></div
    ><h1 data-cut="true" class:list={[loadIn.piece, heroType.title, styles.title]}
      ><span class={styles.line}>I build</span><span class={styles.phrases}
        >{
          SLIDES.map((item, index) => (
            <span
              class={phraseClass(index === 0, false)}
              style={`--c:${item.color}`}
              aria-hidden={index === 0 ? undefined : "true"}
              data-phrase
            ><span class:list={[styles.line, styles.nowrap]}>{item.phrase}</span><span
                class={styles.line}
              ><span class={heroType.hl}>{item.highlight}</span>.</span></span>
          ))
        }</span
      ></h1
    ><p class:list={[loadIn.piece, heroType.lead]} data-cut="true"
      >{"I'm Faqih, a full-stack engineer with 5+ years on web products: frontends, backends, and lately the agent tooling around them. Right now I'm building healthcare software at"}<Fragment
        set:html="<!-- -->"
      /> <a
        class={styles.leadLink}
        href="https://evidence.care"
        target="_blank"
        rel="noopener noreferrer">EvidenceCare</a
      >.</p
    ><div class={heroType.acts}
      ><a
        class:list={[loadIn.piece, button.base, buttonVariant["primary-brand"], button.lift, styles.go]}
        href="#contact"
        data-cut="true"
        style={`--c:${current.color}`}
        data-part="go">Connect with me</a
      ><a class:list={[loadIn.piece, styles.cue]} href="#rules" data-cut="true"
        ><span class={styles.mouse} aria-hidden="true"
          ><span class={styles.wheel}></span></span
        >Scroll down</a
      ></div
    ></div
  ><div
    class:list={[loadIn.piece, styles.bench]}
    data-cut="true"
    style={`--c:${current.color}`}
    data-part="bench"
    ><HeroPrints /><div class={styles.controls}
      ><div class={styles.pips} role="group" aria-label="What I build"
        >{
          SLIDES.map((item, index) => (
            <button
              type="button"
              class:list={[styles.pip, marker]}
              aria-label={item.tab}
              aria-pressed={index === 0 ? "true" : "false"}
              style={`--c:${item.color};--ms:${SLIDE_MS}ms`}
              data-pip
            ><i class={barClass(index === 0, false)}></i></button>
          ))
        }</div
      ><button type="button" class={styles.pause} aria-label="Pause" data-part="pause"
        ><span aria-hidden="true" class={glyphClass(true)}>▶</span><span
          aria-hidden="true"
          class={glyphClass(false)}>❚❚</span
        ></button
      ></div
    ></div
  ></home-hero
>

<script>
  import "./hero.client";
</script>
