---
import * as stylex from "@stylexjs/stylex";
import { SLIDES } from "../../data/home";
import { button, buttonVariant } from "../../components/button";
import { loadIn } from "../../components/load-in";
import { heroType } from "../hero-type";
import { veil } from "../section";
import { SLIDE_MS } from "./hero-prints.styles";
import { barClass, glyphClass, marker, phraseClass, styles } from "./hero.styles";
import HeroPrints from "./hero-prints.astro";

// The home hero (hero.client.ts): the headline cycles through what I build, and the bench beside
// it shows each in print.
const current = SLIDES[0]!;
---

<home-hero {...stylex.attrs(styles.root)}
  ><div {...stylex.attrs(veil.soft)}
    ><div {...stylex.attrs(loadIn.veil, veil.dense, heroType.tag)} data-cut="true"
      ><span {...stylex.attrs(loadIn.piece, loadIn.words)} data-cut="true"
        >Full-stack engineer · Indonesia</span
      ></div
    ><h1 data-cut="true" {...stylex.attrs(loadIn.piece, heroType.title, styles.title)}
      ><span {...stylex.attrs(styles.line)}>I build</span><span {...stylex.attrs(styles.phrases)}
        >{
          SLIDES.map((item, index) => (
            <span
              class={phraseClass(index === 0, false)}
              style={`--c:${item.color}`}
              aria-hidden={index === 0 ? undefined : "true"}
              data-phrase
            ><span {...stylex.attrs(styles.line, styles.nowrap)}>{item.phrase}</span><span
                {...stylex.attrs(styles.line)}
              ><span {...stylex.attrs(heroType.hl)}>{item.highlight}</span>.</span></span>
          ))
        }</span
      ></h1
    ><p {...stylex.attrs(loadIn.piece, heroType.lead)} data-cut="true"
      >{"I'm Faqih, a full-stack engineer with 5+ years on web products: frontends, backends, and lately the agent tooling around them. Right now I'm building healthcare software at"}<Fragment
        set:html="<!-- -->"
      /> <a
        {...stylex.attrs(styles.leadLink)}
        href="https://evidence.care"
        target="_blank"
        rel="noopener noreferrer">EvidenceCare</a
      >.</p
    ><div {...stylex.attrs(heroType.acts)}
      ><a
        {...stylex.attrs(loadIn.piece, button.base, buttonVariant["primary-brand"], styles.go)}
        href="#contact"
        data-cut="true"
        style={`--c:${current.color}`}
        data-part="go">Connect with me</a
      ><a {...stylex.attrs(loadIn.piece, styles.cue)} href="#rules" data-cut="true"
        ><span {...stylex.attrs(styles.mouse)} aria-hidden="true"
          ><span {...stylex.attrs(styles.wheel)}></span></span
        >Scroll down</a
      ></div
    ></div
  ><div
    {...stylex.attrs(loadIn.piece, styles.bench)}
    data-cut="true"
    style={`--c:${current.color}`}
    data-part="bench"
    ><HeroPrints /><div {...stylex.attrs(styles.controls)}
      ><div {...stylex.attrs(styles.pips)} role="group" aria-label="What I build"
        >{
          SLIDES.map((item, index) => (
            <button
              type="button"
              {...stylex.attrs(styles.pip, marker)}
              aria-label={item.tab}
              aria-pressed={index === 0 ? "true" : "false"}
              style={`--c:${item.color};--ms:${SLIDE_MS}ms`}
              data-pip
            ><i class={barClass(index === 0, false)}></i></button>
          ))
        }</div
      ><button type="button" {...stylex.attrs(styles.pause)} aria-label="Pause" data-part="pause"
        ><span aria-hidden="true" class={glyphClass(true)}>▶</span><span
          aria-hidden="true"
          class={glyphClass(false)}>❚❚</span
        ></button
      ></div
    ></div
  ></home-hero
>

<script>
  import "./hero.client";
</script>
