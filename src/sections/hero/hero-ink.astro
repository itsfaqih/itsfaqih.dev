---
import * as stylex from "@stylexjs/stylex";
import { draw, styles, type TopInk } from "./hero-prints.styles";

// A figure printed in two passes: the halftone screen offset beneath it, then its top ink.
type Props = {
  p: string;
  top?: TopInk;
  tag: "path" | "rect" | "circle" | "polygon";
  figure: Record<string, string | number | undefined>;
};

const { p, top = "solid", tag: Figure, figure } = Astro.props;
---

<g transform="translate(5 4)" fill={`url(#${p}ht)`} {...stylex.attrs(styles.part, styles.screen)}
  ><Figure {...figure} /></g
>{
  top === "solid" && (
    <g {...draw(styles.ink)}>
      <Figure {...figure} />
    </g>
  )
}{
  top === "hue" && (
    <g {...draw(styles.hue, styles.screen)}>
      <Figure {...figure} />
    </g>
  )
}{
  top === "outline" && (
    <g {...draw(styles.inkLine)} stroke-width="3">
      <Figure {...figure} />
    </g>
  )
}
