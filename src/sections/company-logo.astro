---
import * as stylex from "@stylexjs/stylex";
import { companyLogo, LOGOS, toneOf } from "./company-logos";
import { styleOf } from "./tech-brand";
import { icon, techBadge } from "./tech-icon.styles";

/**
 * An employer's mark in one colour, which `xstyle` can tint, over the mark in its own colours as
 * toneOf sets them for the theme. The colours show while an ancestor sets --lit to 1 (iconLit).
 */
type Props = { name: string; xstyle?: stylex.StyleXStyles };

const { name, xstyle } = Astro.props;
const logo = LOGOS.get(name);
---

{
  logo && (
    <span {...stylex.attrs(icon.pair, xstyle)} aria-hidden="true">
      <svg {...stylex.attrs(icon.flat)} viewBox={logo.viewBox}>
        {logo.parts.map((part) => (
          <path d={part.d} fill-rule={part.evenOdd ? "evenodd" : undefined} />
        ))}
      </svg>
      <svg {...stylex.attrs(icon.lit)} viewBox={logo.viewBox}>
        {logo.parts.map((part) => (
          <path
            {...stylex.attrs(techBadge.brand, companyLogo.part)}
            style={styleOf(toneOf(part))}
            d={part.d}
            fill-rule={part.evenOdd ? "evenodd" : undefined}
          />
        ))}
      </svg>
    </span>
  )
}
