---
import * as stylex from "@stylexjs/stylex";
import type { StackGroup, StackUse } from "./home-content";
import { chips } from "./chips";
import { ringOf } from "./company-logos";
import { techBrand } from "./tech-brand";
import { iconLit, techBadge } from "./tech-icon.styles";
import { section, veil } from "./section";
import { loadIn } from "../components/load-in";
import {
  countClass,
  groupLabelClass,
  groupWordsClass,
  styles,
  toolClass,
} from "./stack-showcase.styles";
import CompanyLogo from "./company-logo.astro";
import TechIcon from "./tech-icon.astro";

type Props = { groups: StackGroup[]; sources: { use: StackUse; stack: string[] }[] };

const { groups, sources } = Astro.props;

const FILTER_ROWS = [
  { kind: "work", label: "Company", color: "var(--ts)" },
  { kind: "project", label: "Project", color: "var(--ar)" },
] as const;

const placesOf = (kind: StackUse["kind"]) =>
  sources.filter(({ use }) => use.kind === kind).map(({ use }) => use.name);
const usesOf = (tool: string) =>
  sources.filter(({ stack }) => stack.includes(tool)).map(({ use }) => use);
const allTools = groups.flatMap((group) => group.tools);
const usedAt = Object.fromEntries(
  allTools.map((tool) => [tool, usesOf(tool).map((use) => use.name)]),
);
const lists = (tool: string) =>
  [
    { title: "Work", uses: usesOf(tool).filter((use) => use.kind === "work") },
    { title: "Projects", uses: usesOf(tool).filter((use) => use.kind === "project") },
  ].filter(({ uses }) => uses.length > 0);
---

<stack-showcase {...stylex.attrs(styles.host)}
  ><section id="stack" {...stylex.attrs(section.block, styles.section)}
    ><div {...stylex.attrs(section.head)}
      ><h2 {...stylex.attrs(section.title, veil.soft)}
        ><small
          {...stylex.attrs(loadIn.veil, section.eyebrow, veil.dense, veil.fit)}
          data-cut="true"
          data-eyebrow="true"
          style="--c:var(--ar)"
          ><span {...stylex.attrs(loadIn.piece, loadIn.words)} data-cut="true">Tools I use</span
          ></small
        ><span {...stylex.attrs(loadIn.piece, section.titleText)} data-cut="true">Stack</span></h2
      ></div
    ><div {...stylex.attrs(styles.filter)}
      ><div {...stylex.attrs(styles.row)}
        ><span {...stylex.attrs(styles.spacer)}></span><div
          {...stylex.attrs(chips.group, styles.chips)}
          ><button
            type="button"
            {...stylex.attrs(loadIn.piece, chips.chip)}
            data-cut="true"
            aria-pressed="true"
            style="--c:var(--go)"
            data-chip=""
            ><i {...stylex.attrs(chips.dot)}></i>All<b class={countClass(true)}>{allTools.length}</b
            ></button
          ></div
        ></div
      >{
        FILTER_ROWS.filter((row) => placesOf(row.kind).length > 0).map((row) => (
          <div {...stylex.attrs(styles.row)}>
            <h3 {...stylex.attrs(loadIn.veil, veil.dense, styles.rowLabel)} data-cut="true">
              <span {...stylex.attrs(loadIn.piece, loadIn.words)} data-cut="true">{row.label}</span>
            </h3>
            <div
              {...stylex.attrs(chips.group, styles.chips)}
              role="group"
              aria-label={`Filter by ${row.label.toLowerCase()}`}
            >
              {placesOf(row.kind).map((name) => (
                <button
                  type="button"
                  {...stylex.attrs(loadIn.piece, chips.chip, row.kind === "work" && styles.ringChip)}
                  data-cut="true"
                  aria-pressed="false"
                  style={`--c:${row.color}${row.kind === "work" ? `;${ringOf(name)}` : ""}`}
                  data-chip={name}
                >{row.kind === "work" ? (
                    <CompanyLogo name={name} xstyle={styles.chipLogo} />
                  ) : (
                    <i {...stylex.attrs(chips.dot)} />
                  )}{name}<b class={countClass(false)}>{
                    allTools.filter((tool) => usedAt[tool]!.includes(name)).length
                  }</b></button>
              ))}
            </div>
          </div>
        ))
      }</div
    ><div {...stylex.attrs(styles.groups)} data-part="groups"
      >{
        groups.map((group) => (
          <div {...stylex.attrs(styles.group)}>
            <h3 class={groupLabelClass(false)} data-cut="true">
              <span class={groupWordsClass(false)} data-cut="true">{group.label}</span>
            </h3>
            <ul {...stylex.attrs(styles.tools)}>
              {group.tools.map((tool) => (
                <li
                  class={toolClass(false)}
                  data-cut="true"
                  tabindex="0"
                  style={techBrand(tool)}
                  data-tool={tool}
                  data-used-at={JSON.stringify(usedAt[tool])}
                ><TechIcon name={tool} />{tool}</li>
              ))}
            </ul>
          </div>
        ))
      }</div
    ><template data-part="card"
      ><div
        id="stack-peek"
        role="tooltip"
        {...stylex.attrs(techBadge.brand, iconLit.on, styles.peek)}></div
      ></template
    >{
      groups.flatMap((group) =>
        group.tools.map((tool) => (
          <template data-peek={tool} data-style={techBrand(tool)}>
            <header {...stylex.attrs(styles.peekHead)}>{tool}<small {...stylex.attrs(styles.peekGroup)}>{group.label}</small></header>
            {lists(tool).length === 0 && (
              <p {...stylex.attrs(styles.peekNote)}>Not part of a role or project listed on this site.</p>
            )}
            {lists(tool).map(({ title, uses }) => (
              <Fragment>
                <h4 {...stylex.attrs(styles.useTitle)}>{title}</h4>
                <ul {...stylex.attrs(styles.uses)}>
                  {uses.map((use) => (
                    <li {...stylex.attrs(styles.use)}>
                      <b {...stylex.attrs(styles.useName)}>{use.name}</b>
                      <span {...stylex.attrs(styles.useDetail)}>{use.detail}</span>
                    </li>
                  ))}
                </ul>
              </Fragment>
            ))}
          </template>
        )),
      )
    }</section
  ></stack-showcase
>

<script>
  import "./stack-showcase.client";
</script>
