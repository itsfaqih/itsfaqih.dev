---
import * as stylex from "@stylexjs/stylex";
import { colorOf, ruleNumber, type PublishedGuideline } from "../data/guidelines";
import { loadIn } from "../components/load-in";
import { reticle } from "./reticle";
import { styles } from "./rule-select.styles";
import RuleThumb from "./rule-thumb.astro";

type Props = { rule: PublishedGuideline };

const { rule } = Astro.props;
---

<a
  href={rule.href}
  {...stylex.attrs(loadIn.piece, loadIn.deal, reticle.card, reticle.on, styles.tile)}
  data-cut="true"
  style={`--c:${colorOf(rule.label)}`}
  data-rule-open
  ><RuleThumb rule={rule} /><span {...stylex.attrs(styles.number)}
    ><span>{ruleNumber(rule)}</span><span aria-label="Has demos">▶</span></span
  >{/* .t names the title for the rule-open view transition in arcade.css. */}<span
    class={`t ${stylex.attrs(styles.tileTitle).class}`}>{rule.title}</span
  ></a
>
