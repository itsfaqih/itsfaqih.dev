---
import { cx } from "../cx";
import { VISIBLE_GUIDELINES } from "../data/guidelines";
import { SHOW_PROJECTS } from "../data/home";
import { LINKS } from "../seo";
import { arcade } from "../components/arcade.css";
import { button } from "../components/button.css";
import { buttonVariant } from "../components/button";
import Icon from "../components/icon.astro";
import { hoverHold } from "../components/hover-hold.css";
import { loadIn } from "../components/load-in.css";
import Backdrop from "./backdrop.astro";
import ExperienceList from "./experience-list.astro";
import Hero from "./hero/hero.astro";
import { heroType } from "./hero-type.css";
import { EXPERIENCE, PROJECTS, STACK_GROUPS, STACK_SOURCES, TICKER_RUN } from "./home-content";
import { styles } from "./home.css";
import Intro from "./intro.astro";
import { reticle } from "./reticle.css";
import RuleSpread from "./rule-spread.astro";
import { section, veil } from "./section.css";
import StackShowcase from "./stack-showcase.astro";

const eyebrow = cx(loadIn.veil, section.eyebrow, veil.dense, veil.fit);
const words = cx(loadIn.piece, loadIn.words);
const titleText = cx(loadIn.piece, section.titleText);
const external = { target: "_blank", rel: "noopener noreferrer" };
const footerVeil = cx(loadIn.veil, veil.dense);
---

{/* The ticker is the third child: loadIn.piece staggers on :nth-child, so the backdrop goes last. */}
<home-page class={`arc ${cx(arcade.root, arcade.scan, styles.root)}`}
  ><Intro /><div class={arcade.wrap}><Hero /></div><div
    class:list={[loadIn.piece, styles.ticker]}
    data-loop="true"
    data-cut="true"
    aria-hidden="true"
    ><div class:list={[styles.tickerTrack, styles.pausable]}
      >{
        TICKER_RUN.map(({ ticker, color }) => (
          <span class:list={[styles.tickerTile, styles.pausable]} style={`--c:${color}`}
            >{ticker}<Fragment set:html="<!-- -->" /> ★</span
          >
        ))
      }</div
    ></div
  ><div class={arcade.wrap}
    ><section id="rules" class={section.block}
      ><div class={section.head}
        ><h2 class:list={[section.title, veil.soft]}
          ><small class={eyebrow} data-cut="true" data-eyebrow="true" style="--c:var(--cw)"
            ><span class={words} data-cut="true">Writing</span></small
          ><span class={titleText} data-cut="true">Rule of Thumb</span></h2
        ><p class:list={[loadIn.veil, section.blurb, veil.dense]} data-cut="true"
          ><span class={words} data-cut="true">Opinions I've earned from my experience</span></p
        ></div
      ><RuleSpread rules={VISIBLE_GUIDELINES} /></section
    ><section id="work" class={section.block}
      ><div class={section.head}
        ><h2 class:list={[section.title, veil.soft]}
          ><small class={eyebrow} data-cut="true" data-eyebrow="true" style="--c:var(--ux)"
            ><span class={words} data-cut="true">Experience</span></small
          ><span class={titleText} data-cut="true">Where I've worked</span></h2
        ><a
          class:list={[loadIn.piece, button.base, buttonVariant["secondary-pink"], button.iconEnd, button.lift, styles.overDots]}
          href="/cv"
          data-cut="true"
          >View CV<Icon name="ArrowRight" size={18} weight="bold" class={button.nudge} /></a
        ></div
      ><ExperienceList jobs={EXPERIENCE} /></section
    ><StackShowcase groups={STACK_GROUPS} sources={STACK_SOURCES} />{
      SHOW_PROJECTS && (
        <section id="projects" class={section.block}
          ><div class={section.head}
            ><h2 class:list={[section.title, veil.soft]}
              ><small class={eyebrow} data-cut="true" data-eyebrow="true" style="--c:var(--ts-deep)"
                ><span class={words} data-cut="true">Side projects</span></small
              ><span class={titleText} data-cut="true">Projects</span></h2
            ></div
          ><div class={styles.projects}
            >{
              PROJECTS.map((project) => (
                <a
                  class:list={[loadIn.piece,
                    reticle.card,
                    reticle.aim,
                    hoverHold.lift,
                    styles.project]}
                  data-cut="true"
                  href={project.href}
                  {...external}
                  style={`--c:${project.color}`}
                  ><small class={styles.projectKind}>{project.kind}</small><h3
                    class={styles.projectTitle}>{project.title}</h3
                  ><p class={styles.projectSummary}>{project.summary}</p></a
                >
              ))
            }</div
          ></section
        >
      )
    }<div id="contact" class:list={[loadIn.piece, styles.contact]} data-cut="true"
      ><h2 class={section.title}
        ><small
          class:list={[loadIn.piece, section.eyebrow]}
          data-cut="true"
          data-eyebrow="true"
          style="--c:var(--ax)">Connect</small
        ><span class={titleText} data-cut="true"
          >Ready to bring the next level of care to your product?</span
        ></h2
      ><div
        class:list={[loadIn.piece, heroType.acts, styles.contactActs]}
        data-cut="true"
        ><a
          class:list={[button.base, buttonVariant["primary-purple"], button.lift]}
          href={`mailto:${LINKS.email}`}>{`Email ${LINKS.email}`}</a
        ><a
          class:list={[button.base, buttonVariant["secondary-purple"], button.lift]}
          href={LINKS.linkedin}
          {...external}>LinkedIn</a
        ></div
      ></div
    ><footer class={styles.footer}
      ><span class={footerVeil} data-cut="true"
        ><span class={words} data-cut="true">© 2026 Faqih Muntashir</span></span
      ><span class={footerVeil} data-cut="true"
        ><span class={words} data-cut="true"
          ><a class={styles.footerLink} href={LINKS.github} {...external}>GitHub</a> <Fragment
            set:html="<!-- -->·<!-- -->"
          /> <a class={styles.footerLink} href={LINKS.linkedin} {...external}>LinkedIn</a> <Fragment
            set:html="<!-- -->·<!-- -->"
          /> <a class={styles.footerLink} href={LINKS.dribbble} {...external}>Dribbble</a> <Fragment
            set:html="<!-- -->·<!-- -->"
          /> <a class={styles.footerLink} href={LINKS.medium} {...external}>Medium</a></span
        ></span
      ></footer
    ></div
  ><Backdrop /></home-page
>

<script>
  import "./home.client";
</script>
