---
import { type ClassValue } from "../cx";
import { TECH_LOGOS } from "./tech-logos";
import { instanceSuffix, MARKS } from "./tech-brand";
import { icon, mark as markStyles } from "./tech-icon.css";

/**
 * A tool's one-colour mark (drawn from its logo where simple-icons draws another shape), which
 * `class` can tint, over its logo in its own colours: the logo themed by scripts/tech-logos.py, or
 * the mark in its brand colour where there is no such logo. The colours show while an ancestor sets
 * --lit to 1 (iconLit), and the mark fades out for them. A logo wider than it is tall (the VoidZero
 * marks in their parentheses) widens the icon to fit.
 */
type Props = { name: string; class?: ClassValue };

const { name, class: className } = Astro.props;
const mark = MARKS.get(name);
const logo = TECH_LOGOS.get(name);
const suffix = instanceSuffix();
const [, , width = 1, height = 1] = logo?.viewBox.split(" ").map(Number) ?? [];
const viewBox = mark?.viewBox ?? "0 0 24 24";
const fillRule = mark?.evenOdd ? "evenodd" : undefined;
---

{
  mark && (
    <span
      class:list={[icon.pair, className]}
      style={width > height ? `--wide:${width / height}` : undefined}
      aria-hidden="true"
    >
      {logo?.flat ? (
        <svg class={icon.flat} viewBox={logo.viewBox} set:html={logo.flat.replaceAll("$", suffix)} />
      ) : (
        <svg class={icon.flat} viewBox={viewBox}>
          <path d={mark.path} fill-rule={fillRule} />
        </svg>
      )}
      {logo ? (
        <svg class={icon.lit} viewBox={logo.viewBox} set:html={logo.body.replaceAll("$", suffix)} />
      ) : (
        <svg class:list={[icon.lit, markStyles.brand]} viewBox={viewBox}>
          <path d={mark.path} fill-rule={fillRule} />
        </svg>
      )}
    </span>
  )
}
