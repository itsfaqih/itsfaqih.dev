---
import { segView, type Seg } from "./header.view";
import { styles } from "./header.css";

type Props = { name: Seg };

const { name } = Astro.props;
const view = segView(name, { scrolled: false, open: false, live: false });
---

<div class={view.seg} data-compact={view.compact} inert={!view.on} data-seg={name}>
  <div class={styles.clip}><div class={view.row}><slot /></div></div>
</div>
