---
import type { RuleId } from "../data/guidelines";

// Drawn on Phosphor's 256 grid at its regular weight, so a rule sits beside the stock icons.
type Props = { id: RuleId; size?: number };

const { id, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="none"
  stroke="currentColor"
  stroke-width="16"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    id === "proximity-principle" && (
      <>
        <path d="M32 72v128a8 8 0 0 0 8 8h176a8 8 0 0 0 8-8V96a8 8 0 0 0-8-8h-86l-26-24H40a8 8 0 0 0-8 8Z" />
        <rect x="74" y="120" width="48" height="48" rx="8" />
        <rect x="134" y="120" width="48" height="48" rx="8" />
      </>
    )
  }
  {
    id === "typescript-code-writing" && (
      <path d="M72 64 24 128l48 64M184 64l48 64-48 64M100 96h56M128 96v72" />
    )
  }
  {
    id === "button-design" && (
      <>
        <rect x="24" y="40" width="208" height="88" rx="28" />
        <path d="M72 84h64M152 152l72 26-32 14-14 32Z" />
      </>
    )
  }
  {
    id === "table-design" && (
      <>
        <rect x="32" y="48" width="192" height="160" rx="12" />
        <path d="M32 96h192M32 152h192M104 96v112" />
      </>
    )
  }
  {
    id === "dialog-design" && (
      <>
        <rect x="24" y="40" width="208" height="176" rx="16" stroke-opacity="0.4" />
        <rect x="56" y="80" width="144" height="96" rx="12" />
        <path d="M136 144h40" />
      </>
    )
  }
  {
    id === "form-submission" && (
      <>
        <rect x="32" y="40" width="192" height="48" rx="12" />
        <rect x="32" y="112" width="192" height="48" rx="12" />
        <path d="m136 200 24 24 48-48" />
      </>
    )
  }
  {
    id === "data-loading" && (
      <>
        <rect x="24" y="40" width="208" height="176" rx="16" />
        <path d="M64 88h80M64 128h56M64 168h96M184 88h8M184 128h8M184 168h8" />
      </>
    )
  }
  {
    id === "handling-timestamps" && (
      <>
        <circle cx="128" cy="128" r="96" />
        <path d="M128 72v56l40 24" />
      </>
    )
  }
  {
    id === "null-vs-undefined" && (
      <>
        <rect x="16" y="64" width="104" height="128" rx="16" />
        <rect x="136" y="64" width="104" height="128" rx="16" stroke-dasharray="20 20" />
        <path d="M48 108a20 20 0 1 1 28 18c-6 3-8 7-8 12v2" />
        <circle cx="68" cy="166" r="4" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>
