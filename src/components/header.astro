---
import { cx } from "../cx";
import { SHOW_PROJECTS } from "../data/home";
import { arcade } from "./arcade.css";
import { button } from "./button.css";
import { fluidHover } from "./fluid-hover.css";
import { menuGlyphs } from "./header.view";
import { styles } from "./header.css";
import Seg from "./header-seg.astro";
import Icon from "./icon.astro";

type Props = {
  /** The page's pathname, which marks the current section's link. */
  path: string;
};

const { path } = Astro.props;
const current = (active: boolean) => (active ? "page" : undefined);
// The server can't see the hash; header.client.ts marks these once it can.
const hashOnHome = (hash: string) => (path === "/" ? hash : undefined);
const glyphs = menuGlyphs(false);
---

<site-header
  class={`arc arc-bar ${cx(arcade.root, styles.bar)}`}
>
  <header class={`island ${styles.island}`}>
    <Seg name="home">
      <a href="/" aria-label="Faqih Muntashir, home" class:list={[styles.brand, styles.ring]}>
        FAQIH
      </a>
    </Seg>
    <Seg name="live"><div data-island-activity></div></Seg>
    <Seg name="nav">
      <nav aria-label="Main" class={styles.nav}>
        <a
          href="/rule-of-thumb"
          aria-current={current(path.startsWith("/rule-of-thumb"))}
          data-fluid-item="true"
          class:list={[styles.navLink, styles.ring]}>Rule of Thumb</a
        >
        <a
          href="/#work"
          data-hash={hashOnHome("#work")}
          data-fluid-item="true"
          class:list={[styles.navLink, styles.ring, styles.wideOnly]}>Experience</a
        >
        {
          SHOW_PROJECTS && (
            <a
              href="/#projects"
              data-hash={hashOnHome("#projects")}
              data-fluid-item="true"
              class:list={[styles.navLink, styles.ring, styles.wideOnly]}
            >
              Projects
            </a>
          )
        }
      </nav>
    </Seg>
    <Seg name="tools">
      <button
        type="button"
        aria-label="Search the site"
        data-fluid-item="true"
        data-part="search"
        class:list={[styles.find, styles.ring]}
        ><Icon name="MagnifyingGlass" size={16} weight="bold" /><kbd
          class:list={[styles.findKey, styles.wideOnly]}>⌘K</kbd
        ></button
      ><button
        type="button"
        aria-label="Switch theme"
        data-fluid-item="true"
        data-part="theme"
        class:list={[styles.find, styles.ring, styles.iconButton]}
        ><Icon
          name="Sun"
          size={16}
          weight="bold"
          class:list={[styles.glyph, styles.sunInLight]}
        /><Icon
          name="Moon"
          size={16}
          weight="bold"
          class:list={[styles.glyph, styles.moonInDark]}
        /></button
      >
    </Seg>
    <Seg name="connect">
      <a href="/#contact" class:list={[button.base, button.sm, styles.connect]}>Connect</a>
    </Seg>
    <Seg name="menu">
      <button
        type="button"
        class={`find menu ${cx(styles.find, styles.ring, styles.iconButton, styles.menu)}`}
        aria-expanded="false"
        aria-label="Open menu"
        data-fluid-item="true"
        data-part="menu"
        ><Icon name="List" size={16} weight="bold" class={glyphs.list} data-part="list" /><Icon
          name="X"
          size={16}
          weight="bold"
          class={glyphs.x}
          data-part="x"
        /></button
      >
    </Seg>
    <span data-part="ground" aria-hidden="true" class={styles.ground}></span>
    <span
      data-part="highlight"
      aria-hidden="true"
      class:list={[fluidHover.highlight, styles.highlight]}></span>
  </header>
</site-header>

<script>
  import "./header.client";
</script>
