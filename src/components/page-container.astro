---
import { type ClassValue } from "../cx";
import { maxWidths, styles } from "./page-container.css";

type Props = {
  maxWidth?: "2xl" | "3xl" | "4xl";
  style?: ClassValue;
};

const { maxWidth = "2xl", style } = Astro.props;
---

<div class:list={[styles.container, maxWidths[maxWidth], style]}><slot /></div>
