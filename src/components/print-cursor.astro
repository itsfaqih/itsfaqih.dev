---
import { marker } from "../when";
import { styles } from "./print-cursor.css";
---

<print-cursor class:list={[styles.root, marker]} aria-hidden="true">
  <svg viewBox="-24 -24 48 48" class={styles.svg}>
    <defs>
      <pattern
        id="pc-dots"
        width="3.6"
        height="3.6"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(18)"
      >
        <circle cx="1.8" cy="1.8" r="1.3" class={styles.dot}></circle>
      </pattern>
    </defs>
    <g class={styles.body}>
      <g data-part="plate">
        <path data-part="plate-dots" fill="url(#pc-dots)" class={styles.crisp}></path>
      </g>
      <path data-part="ink" class:list={[styles.crisp, styles.ink]}></path>
      <path data-part="fill" class:list={[styles.crisp, styles.fill]}></path>
    </g>
  </svg>
</print-cursor>

<script>
  import "./print-cursor.client";
</script>
