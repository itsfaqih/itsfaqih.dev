---
import * as stylex from "@stylexjs/stylex";
import { marker, styles } from "./print-cursor.styles";
---

<print-cursor {...stylex.attrs(styles.root, marker)} aria-hidden="true">
  <svg viewBox="-24 -24 48 48" {...stylex.attrs(styles.svg)}>
    <defs>
      <pattern
        id="pc-dots"
        width="3.6"
        height="3.6"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(18)"
      >
        <circle cx="1.8" cy="1.8" r="1.3" {...stylex.attrs(styles.dot)}></circle>
      </pattern>
    </defs>
    <g {...stylex.attrs(styles.body)}>
      <g data-part="plate">
        <path data-part="plate-dots" fill="url(#pc-dots)" {...stylex.attrs(styles.crisp)}></path>
      </g>
      <path data-part="ink" {...stylex.attrs(styles.crisp, styles.ink)}></path>
      <path data-part="fill" {...stylex.attrs(styles.crisp, styles.fill)}></path>
    </g>
  </svg>
</print-cursor>

<script>
  import "./print-cursor.client";
</script>
