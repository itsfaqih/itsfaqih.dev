---
import { cx } from "../cx";
import { arcade } from "../components/arcade.css";
import { button } from "../components/button.css";
import { buttonVariant } from "../components/button";
import Icon from "../components/icon.astro";
import { CV, CV_PDF } from "../data/cv";
import Backdrop from "../sections/backdrop.astro";
import { styles } from "./cv-page.css";

const external = { target: "_blank", rel: "noopener noreferrer" };
const heading = styles.heading;
const section = styles.section;
const entry = styles.entry;
const entryTitle = styles.entryTitle;
const text = styles.text;
const label = styles.label;
const list = styles.list;
const point = styles.point;
const link = styles.link;
const designOnly = styles.designOnly;
const atsOnly = styles.atsOnly;
// A parser reads a link's text, not its target, so the ATS version writes the address out.
const address = (href: string) => href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<cv-page class={`arc ${cx(arcade.root, arcade.scan, styles.root)}`}>
  <Backdrop />
  <div class:list={[arcade.wrap, styles.column]}>
    <div class={styles.bar}>
      <a
        class:list={[button.base, buttonVariant["primary-brand"], button.iconStart]}
        href={CV_PDF.design.href}
        download={CV_PDF.design.fileName}
        ><Icon name="DownloadSimple" size={18} weight="bold" />Download</a
      >
      <label class={styles.switch}>
        <input class={styles.track} type="checkbox" role="switch" autocomplete="off" />
        ATS friendly
      </label>
    </div>
    <article class={styles.sheet}>
      <header class={styles.head}>
        <div>
          <h1 class={styles.name}>{CV.name}</h1>
          <p class={styles.role}>{CV.headline}</p>
          <p class={styles.line}>
            {CV.location} | <a class={link} href={`mailto:${CV.email}`}>{CV.email}</a>
          </p>
          <p class={styles.line}>
            {
              CV.links.map(({ label: name, href }, index) => (
                <>
                  {index > 0 && " | "}
                  <a class={link} href={href} {...external}>
                    <span class={designOnly}>{name}</span>
                    <span class={atsOnly}>{address(href)}</span>
                  </a>
                </>
              ))
            }
          </p>
        </div>
      </header>

      <section class={section}>
        {CV.summary.map((paragraph) => <p class={text}>{paragraph}</p>)}
      </section>

      <section class={section}>
        <h2 class={heading}>Professional Experience</h2>
        {
          CV.experience.map(({ title, points }) => (
            <div class={entry}>
              <h3 class={entryTitle}>{title}</h3>
              <ul class={list}>
                {points.map((item) => (
                  <li class={point}>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class={section}>
        <h2 class={heading}>Skills &amp; Competencies</h2>
        <p class={text}>{CV.skills}</p>
      </section>

      <section class={section}>
        <h2 class={heading}>Tech Stack &amp; Tools</h2>
        {
          CV.stack.map((group) => (
            <p class={text}>
              <span class={label}>{group.label}:</span> {group.text}
            </p>
          ))
        }
      </section>

      <section class={section}>
        <h2 class={heading}>Education</h2>
        <h3 class={entryTitle}>{CV.education.title}</h3>
        <p class={text}>{CV.education.detail}</p>
      </section>

      <section class={section}>
        <h2 class={heading}>Achievements</h2>
        <ul class={list}>{CV.achievements.map((item) => <li class={point}>{item}</li>)}</ul>
      </section>

      <section class={section}>
        <h2 class={heading}>Languages</h2>
        <ul class={list}>{CV.languages.map((item) => <li class={point}>{item}</li>)}</ul>
      </section>
    </article>
  </div>
</cv-page>

<script>
  import "./cv-page.client";
</script>
